          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Phase 01 health endpoint."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Service is healthy\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.service).to.eql(\"SCEAMS.API\");",
                  "    pm.expect(body.status).to.eql(\"Healthy\");",
                  "    pm.expect(body.version).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
