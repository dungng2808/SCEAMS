                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"New Student\",\n  \"email\": \"new.student@sceams.edu.vn\",\n  \"studentCode\": \"SE999999\",\n  \"phoneNumber\": \"0900000000\",\n  \"password\": \"{{registerPassword}}\",\n  \"confirmPassword\": \"{{registerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Phase 07 Student registration. Define registerPassword only in the local Postman environment."
          },
          "response": []
        },
        {
          "name": "Login - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains a safe JWT result\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(body.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(body.expiresAtUtc).to.be.a(\"string\");",
                  "    pm.expect(body.refreshTokenExpiresAtUtc).to.be.a(\"string\");",
                  "    pm.expect(body.user.role).to.be.oneOf([\"Admin\", \"Staff\", \"Organizer\", \"Student\"]);",
                  "    pm.expect(body.user).not.to.have.property(\"passwordHash\");",
                  "    pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "    pm.collectionVariables.set(\"refreshToken\", body.refreshToken);",
                  "});",
                  "",
                  "pm.test(\"JWT contains sub, email and role\", function () {",
                  "    const token = pm.response.json().accessToken;",
                  "    const payload = JSON.parse(Buffer.from(token.split(\".\")[1], \"base64\").toString());",
                  "    pm.expect(payload.sub).to.be.a(\"string\");",
                  "    pm.expect(payload.email).to.eql(pm.collectionVariables.get(\"loginEmail\").toLowerCase());",
                  "    pm.expect(payload.role).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Phase 09/17 successful login. Saves the returned access and refresh tokens as secret collection variables."
          },
          "response": []
        },
        {
          "name": "Refresh Token - Rotate",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(",
                  "    \"usedRefreshToken\",",
                  "    pm.collectionVariables.get(\"refreshToken\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Refresh token is rotated\", function () {",
                  "    const body = pm.response.json();",
                  "    const usedToken = pm.collectionVariables.get(\"usedRefreshToken\");",
                  "    pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(body.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(body.refreshToken).not.to.eql(usedToken);",
                  "    pm.expect(body.refreshTokenExpiresAtUtc).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "    pm.collectionVariables.set(\"refreshToken\", body.refreshToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Phase 17 rotates a valid refresh token and saves the replacement token."
          },
          "response": []
