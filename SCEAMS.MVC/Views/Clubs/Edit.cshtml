@model SCEAMS.MVC.ViewModels.EditClubViewModel

@{
    ViewData["Title"] = Model.IsNotFound || Model.IsForbidden || !string.IsNullOrWhiteSpace(Model.ErrorMessage)
        ? "Chỉnh sửa câu lạc bộ"
        : $"Chỉnh sửa - {Model.Name}";
}

<section class="clubs-page" aria-labelledby="edit-club-title">
    <nav class="breadcrumb-nav" aria-label="Điều hướng">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a asp-controller="Clubs" asp-action="Index">Câu lạc bộ</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a asp-controller="Clubs" asp-action="Details" asp-route-id="@Model.Id">@(Model.Name ?? "Chi tiết")</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Chỉnh sửa</span>
    </nav>

    @if (Model.IsNotFound)
    {
        <div class="category-state category-state--empty surface-card" role="alert">
            <span class="category-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 8v4M12 16h.01" />
                </svg>
            </span>
            <div>
                <p class="eyebrow">Không tìm thấy</p>
                <h2>Câu lạc bộ không tồn tại</h2>
                <p>@Model.ErrorMessage</p>
                <div class="category-state__actions">
                    <a class="btn-app btn-app--primary" asp-controller="Clubs" asp-action="Index">
                        Quay lại danh sách câu lạc bộ
                    </a>
                </div>
            </div>
        </div>
    }
    else if (Model.IsForbidden)
    {
        <div class="category-state category-state--error surface-card" role="alert">
            <span class="category-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
            </span>
            <div>
                <p class="eyebrow">Quyền hạn thay đổi</p>
                <h2>Bạn không có quyền chỉnh sửa câu lạc bộ này</h2>
                <p>@(Model.ErrorMessage ?? "Bạn không phải là chủ sở hữu hoặc quản trị viên có quyền hạn chỉnh sửa.")</p>
                <div class="category-state__actions">
                    <a class="btn-app btn-app--primary" asp-controller="Clubs" asp-action="Details" asp-route-id="@Model.Id">
                        Xem chi tiết câu lạc bộ
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <header class="category-hero" style="padding-block: 2rem;">
            <div class="category-hero__copy">
                <div style="display: flex; gap: 0.75rem; align-items: center; margin-bottom: 0.5rem;">
                    <span class="eyebrow" style="margin: 0;">Mã số CLB: #@Model.Id</span>
                    <span class="@Model.StatusBadgeClass">@Model.StatusLabel</span>
                </div>
                <h1 id="edit-club-title" style="margin-top: 0.25rem;">Chỉnh sửa thông tin câu lạc bộ</h1>
                <p style="color: rgba(255, 255, 255, 0.82);">
                    Cập nhật tên, danh mục và nội dung mô tả hoạt động của câu lạc bộ.
                </p>
            </div>
        </header>

        <div class="surface-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); max-width: 52rem; margin-inline: auto; width: 100%;">
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="category-state category-state--error surface-card" style="padding: 1.25rem; margin-bottom: 1.5rem;" role="alert">
                    <span class="category-state__icon" aria-hidden="true" style="width: 2.25rem; height: 2.25rem;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 8v4M12 16h.01" />
                        </svg>
                    </span>
                    <div>
                        <strong style="color: var(--sceams-danger);">Cập nhật thất bại</strong>
                        <p style="margin: 0.25rem 0 0; font-size: 0.9rem;">@Model.ErrorMessage</p>
                    </div>
                </div>
            }

            <form asp-controller="Clubs"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post"
                  novalidate
                  aria-label="Form chỉnh sửa thông tin câu lạc bộ">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="category-state category-state--error surface-card" style="padding: 1rem; margin-bottom: 1.25rem;" role="alert"></div>

                <div style="margin-bottom: 1.5rem;">
                    <label asp-for="Name" style="display: block; font-weight: 700; margin-bottom: 0.4rem; color: var(--sceams-text);">
                        Tên câu lạc bộ <span style="color: var(--sceams-danger);">*</span>
                    </label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Nhập tên câu lạc bộ mới"
                           maxlength="150"
                           style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--sceams-radius-sm); border: 1px solid var(--sceams-border); font-size: 1rem;" />
                    <span asp-validation-for="Name" style="color: var(--sceams-danger); font-size: 0.85rem; display: block; margin-top: 0.35rem;"></span>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <label asp-for="CategoryId" style="display: block; font-weight: 700; margin-bottom: 0.4rem; color: var(--sceams-text);">
                        Lĩnh vực / Danh mục <span style="color: var(--sceams-danger);">*</span>
                    </label>
                    <select asp-for="CategoryId"
                            style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--sceams-radius-sm); border: 1px solid var(--sceams-border); font-size: 1rem; background: var(--sceams-surface);">
                        <option value="">-- Chọn danh mục câu lạc bộ --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" style="color: var(--sceams-danger); font-size: 0.85rem; display: block; margin-top: 0.35rem;"></span>
                </div>

                <div style="margin-bottom: 2rem;">
                    <label asp-for="Description" style="display: block; font-weight: 700; margin-bottom: 0.4rem; color: var(--sceams-text);">
                        Mô tả câu lạc bộ
                    </label>
                    <textarea asp-for="Description"
                              rows="6"
                              placeholder="Cập nhật chi tiết nội dung mô tả mục tiêu và định hướng câu lạc bộ..."
                              maxlength="1000"
                              style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--sceams-radius-sm); border: 1px solid var(--sceams-border); font-size: 1rem; font-family: inherit; line-height: 1.5;"></textarea>
                    <span asp-validation-for="Description" style="color: var(--sceams-danger); font-size: 0.85rem; display: block; margin-top: 0.35rem;"></span>
                </div>

                <div style="display: flex; gap: 1rem; align-items: center; justify-content: flex-end;">
                    <a class="btn-app btn-app--ghost" asp-controller="Clubs" asp-action="Details" asp-route-id="@Model.Id">
                        Hủy bỏ
                    </a>
                    <button type="submit" class="btn-app btn-app--primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width: 1.1rem; height: 1.1rem;" aria-hidden="true">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                            <polyline points="17 21 17 13 7 13 7 21" />
                            <polyline points="7 3 7 8 15 8" />
                        </svg>
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    }
</section>
