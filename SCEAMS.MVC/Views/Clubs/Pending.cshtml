@model SCEAMS.MVC.ViewModels.PendingClubsViewModel

@{
    ViewData["Title"] = "Hàng chờ duyệt câu lạc bộ";
}

<section class="clubs-page" aria-labelledby="pending-clubs-title">
    <nav class="breadcrumb-nav" aria-label="Điều hướng">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a asp-controller="Clubs" asp-action="Index">Câu lạc bộ</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Hàng chờ duyệt</span>
    </nav>

    <header class="category-hero" style="padding-block: 2rem;">
        <div class="category-hero__copy">
            <p class="eyebrow">Quản trị hệ thống &middot; Phê duyệt câu lạc bộ</p>
            <h1 id="pending-clubs-title" style="margin-top: 0.25rem;">Hàng chờ phê duyệt câu lạc bộ</h1>
            <p style="color: rgba(255, 255, 255, 0.82);">
                Danh sách các câu lạc bộ mới được đề xuất đang chờ Ban quản trị (Admin / Staff) xem xét và phê duyệt.
            </p>
        </div>
        <div class="category-hero__summary" style="min-height: 7.5rem; min-width: 10.5rem;">
            <span>Chờ duyệt</span>
            <strong>@Model.PendingClubs.Count</strong>
            <small>Đề xuất mới</small>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="surface-card" style="padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; border-left: 4px solid var(--sceams-success); background: var(--sceams-success-soft);" role="status">
            <strong style="color: var(--sceams-success); display: block; margin-bottom: 0.25rem;">Thành công!</strong>
            <p style="margin: 0; color: var(--sceams-text);">@TempData["SuccessMessage"]</p>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="surface-card" style="padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; border-left: 4px solid var(--sceams-danger); background: var(--sceams-danger-soft);" role="alert">
            <strong style="color: var(--sceams-danger); display: block; margin-bottom: 0.25rem;">Lỗi thao tác!</strong>
            <p style="margin: 0; color: var(--sceams-text);">@TempData["ErrorMessage"]</p>
        </div>
    }

    @if (Model.IsForbidden)
    {
        <div class="category-state category-state--error surface-card" role="alert">
            <span class="category-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
            </span>
            <div>
                <p class="eyebrow">Quyền hạn</p>
                <h2>Bạn không có quyền xem danh sách chờ duyệt</h2>
                <p>@Model.ErrorMessage</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="category-state category-state--error surface-card" role="alert">
            <span class="category-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 8v4M12 16h.01" />
                </svg>
            </span>
            <div>
                <p class="eyebrow">Lỗi kết nối</p>
                <h2>Không thể tải danh sách câu lạc bộ chờ duyệt</h2>
                <p>@Model.ErrorMessage</p>
            </div>
        </div>
    }
    else if (Model.PendingClubs.Count == 0)
    {
        <div class="category-state category-state--empty surface-card" role="status">
            <span class="category-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
            </span>
            <div>
                <p class="eyebrow">Trạng thái hàng chờ</p>
                <h2>Không có câu lạc bộ nào đang chờ duyệt</h2>
                <p>Tất cả đề xuất thành lập câu lạc bộ đã được xử lý xong.</p>
                <div class="category-state__actions">
                    <a class="btn-app btn-app--primary" asp-controller="Clubs" asp-action="Index">
                        Xem tất cả câu lạc bộ
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div style="display: grid; gap: 1.25rem;">
            @foreach (var club in Model.PendingClubs)
            {
                <article class="surface-card" style="padding: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem;">
                    <div style="display: flex; gap: 1.25rem; align-items: center; flex: 1 1 20rem;">
                        <span class="category-card__mark" style="background: var(--sceams-navy-900); color: #fff; width: 3.25rem; height: 3.25rem; font-size: 1.1rem; flex-shrink: 0;" aria-hidden="true">
                            @club.Initials
                        </span>
                        <div>
                            <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.25rem;">
                                <span class="eyebrow" style="margin: 0;">@club.CategoryName</span>
                                <span class="@club.StatusBadgeClass">@club.StatusLabel</span>
                            </div>
                            <h2 style="margin: 0; font-size: 1.25rem;">
                                <a asp-controller="Clubs" asp-action="Details" asp-route-id="@club.Id" style="color: inherit; text-decoration: none;">
                                    @club.Name
                                </a>
                            </h2>
                            <p style="margin: 0.35rem 0 0; color: var(--sceams-text-soft); font-size: 0.9rem;">
                                Đề xuất ngày @club.CreatedAtFormatted bởi <strong>@club.CreatedByUserName</strong>
                            </p>
                        </div>
                    </div>

                    <div style="display: flex; gap: 0.75rem; align-items: center;">
                        <a class="btn-app btn-app--ghost" asp-controller="Clubs" asp-action="Details" asp-route-id="@club.Id">
                            Chi tiết
                        </a>

                        <form asp-controller="Clubs"
                              asp-action="Approve"
                              asp-route-id="@club.Id"
                              method="post"
                              style="margin: 0;"
                              onsubmit="return confirm('Bạn có chắc chắn muốn duyệt cho phép câu lạc bộ \'@club.Name\' hoạt động công khai?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-app btn-app--primary">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width: 1.1rem; height: 1.1rem;" aria-hidden="true">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                Phê duyệt CLB
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>
