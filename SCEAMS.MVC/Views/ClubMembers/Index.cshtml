@model SCEAMS.MVC.ViewModels.ClubMembersViewModel
@{
    ViewData["Title"] = $"Quản lý thành viên - {Model.ClubName}";
}

<div class="page-container" style="max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem;">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <strong>Thành công!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <strong>Có lỗi xảy ra!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.IsNotFound)
    {
        <div class="surface-card" style="padding: 3rem; text-align: center;">
            <h2 style="color: var(--sceams-danger); font-size: 1.5rem; margin-bottom: 1rem;">Không tìm thấy câu lạc bộ</h2>
            <p style="color: var(--sceams-text-soft);">@Model.ErrorMessage</p>
            <a asp-controller="Clubs" asp-action="Index" class="btn-app btn-app--ghost mt-3">&larr; Quay lại danh sách câu lạc bộ</a>
        </div>
    }
    else if (Model.IsForbidden)
    {
        <div class="surface-card" style="padding: 3rem; text-align: center;">
            <h2 style="color: var(--sceams-warning); font-size: 1.5rem; margin-bottom: 1rem;">Truy cập bị từ chối (403)</h2>
            <p style="color: var(--sceams-text-soft);">@Model.ErrorMessage</p>
            <a asp-controller="Clubs" asp-action="Details" asp-route-id="@Model.ClubId" class="btn-app btn-app--ghost mt-3">&larr; Quay lại trang chi tiết CLB</a>
        </div>
    }
    else
    {
        <header style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
            <div>
                <a asp-controller="Clubs" asp-action="Details" asp-route-id="@Model.ClubId" class="btn-app btn-app--ghost mb-2" style="font-size: 0.875rem;">
                    &larr; Về trang chi tiết câu lạc bộ
                </a>
                <h1 style="font-size: 2rem; font-weight: 700; margin: 0; background: linear-gradient(135deg, #1e293b 0%, #3b82f6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    Quản lý thành viên
                </h1>
                <p style="color: var(--sceams-text-soft); margin: 0.25rem 0 0 0; font-size: 1rem;">
                    Câu lạc bộ: <strong>@Model.ClubName</strong>
                </p>
            </div>
        </header>

        <!-- Search & Filter bar -->
        <div class="surface-card" style="padding: 1.25rem; margin-bottom: 1.5rem;">
            <form asp-action="Index" asp-route-clubId="@Model.ClubId" method="get" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
                <input type="hidden" name="tab" value="@Model.ActiveTab" />
                <div style="flex: 1; min-width: 250px;">
                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           placeholder="Tìm theo tên sinh viên hoặc email..."
                           class="form-control"
                           style="border-radius: 0.5rem;" />
                </div>
                <button type="submit" class="btn-app btn-app--primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width: 1rem; height: 1rem;" aria-hidden="true">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    Tìm kiếm
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-action="Index" asp-route-clubId="@Model.ClubId" asp-route-tab="@Model.ActiveTab" class="btn-app btn-app--ghost">
                        Xóa lọc
                    </a>
                }
            </form>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger mb-4" role="alert">
                @Model.ErrorMessage
            </div>
        }

        <!-- Members Table -->
        <div class="surface-card" style="padding: 0; overflow: hidden;">
            <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--sceams-border); display: flex; justify-content: space-between; align-items: center;">
                <h3 style="margin: 0; font-size: 1.15rem; font-weight: 600;">
                    Đơn gia nhập chờ duyệt
                </h3>
                <span class="badge bg-primary rounded-pill">@Model.TotalItems đơn</span>
            </div>

            @if (Model.Members.Count == 0)
            {
                <div style="padding: 4rem 2rem; text-align: center;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width: 3.5rem; height: 3.5rem; color: var(--sceams-text-soft); margin-bottom: 1rem;" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    <h4 style="font-size: 1.1rem; color: var(--sceams-text-dark); margin-bottom: 0.5rem;">Không có đơn gia nhập nào</h4>
                    <p style="color: var(--sceams-text-soft); margin: 0;">Hiện chưa có sinh viên nào đăng ký gia nhập hoặc không tìm thấy kết quả phù hợp.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle style-table mb-0" style="width: 100%;">
                        <thead>
                            <tr style="background: #f8fafc; border-bottom: 1px solid var(--sceams-border);">
                                <th style="padding: 1rem 1.5rem;">Sinh viên</th>
                                <th>Email</th>
                                <th>Ngày đăng ký</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Members)
                            {
                                <tr style="border-bottom: 1px solid var(--sceams-border);">
                                    <td style="padding: 1rem 1.5rem;">
                                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                                            <div style="width: 2.5rem; height: 2.5rem; border-radius: 50%; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem;">
                                                @item.Initials
                                            </div>
                                            <div>
                                                <strong style="display: block; color: var(--sceams-text-dark);">@item.StudentName</strong>
                                                <small style="color: var(--sceams-text-soft);">ID: #@item.StudentId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span style="font-family: monospace; color: var(--sceams-text-dark);">@item.StudentEmail</span>
                                    </td>
                                    <td>
                                        <span>@item.JoinDateFormatted</span>
                                    </td>
                                    <td>
                                        <span class="status-badge @item.StatusBadgeClass">
                                            @item.StatusLabel
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div style="display: inline-flex; gap: 0.5rem; flex-wrap: wrap; justify-content: flex-end;">
                                            <form asp-action="Approve"
                                                  asp-route-clubId="@Model.ClubId"
                                                  asp-route-userId="@item.StudentId"
                                                  method="post"
                                                  style="margin: 0;"
                                                  data-confirm-message="Xác nhận duyệt đơn gia nhập của @item.StudentName?"
                                                  onsubmit="return confirm(this.dataset.confirmMessage);">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="search" value="@Model.Search" />
                                                <input type="hidden" name="page" value="@Model.Page" />
                                                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                <button type="submit" class="btn-app btn-app--primary btn-sm">Duyệt</button>
                                            </form>
                                            <form asp-action="Reject"
                                                  asp-route-clubId="@Model.ClubId"
                                                  asp-route-userId="@item.StudentId"
                                                  method="post"
                                                  style="margin: 0;"
                                                  data-confirm-message="Xác nhận từ chối đơn gia nhập của @item.StudentName?"
                                                  onsubmit="return confirm(this.dataset.confirmMessage);">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="search" value="@Model.Search" />
                                                <input type="hidden" name="page" value="@Model.Page" />
                                                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                <button type="submit" class="btn-app btn-app--ghost btn-sm" style="color: var(--sceams-danger);">Từ chối</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div style="padding: 1.25rem 1.5rem; border-top: 1px solid var(--sceams-border); display: flex; justify-content: space-between; align-items: center;">
                        <small style="color: var(--sceams-text-soft);">
                            Trang @Model.Page / @Model.TotalPages (Tổng @Model.TotalItems bản ghi)
                        </small>
                        <div style="display: flex; gap: 0.5rem;">
                            @if (Model.HasPreviousPage)
                            {
                                <a asp-action="Index"
                                   asp-route-clubId="@Model.ClubId"
                                   asp-route-tab="@Model.ActiveTab"
                                   asp-route-search="@Model.Search"
                                   asp-route-page="@(Model.Page - 1)"
                                   class="btn-app btn-app--ghost btn-sm">
                                    &larr; Trang trước
                                </a>
                            }
                            @if (Model.HasNextPage)
                            {
                                <a asp-action="Index"
                                   asp-route-clubId="@Model.ClubId"
                                   asp-route-tab="@Model.ActiveTab"
                                   asp-route-search="@Model.Search"
                                   asp-route-page="@(Model.Page + 1)"
                                   class="btn-app btn-app--ghost btn-sm">
                                    Trang sau &rarr;
                                </a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>
