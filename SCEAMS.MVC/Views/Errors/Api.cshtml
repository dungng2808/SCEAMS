@model SCEAMS.MVC.ViewModels.ApiErrorViewModel

@{
    ViewData["Title"] = $"Lỗi API {Model.StatusCode}";
}

<section class="error-page" aria-labelledby="api-error-title">
    <div>
        <span class="error-page__code">API · @Model.StatusCode</span>
        <h1 id="api-error-title">@Model.Title</h1>
        <p class="error-page__lead">@Model.Detail</p>
        <div class="error-page__actions">
            @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
            {
                <a class="btn-app btn-app--primary" href="@Model.ReturnUrl">Thử lại</a>
            }
            <a class="btn-app btn-app--ghost" asp-controller="Home" asp-action="Index">Về trang chủ</a>
            <a class="btn-app btn-app--ghost" asp-controller="System" asp-action="Health">Kiểm tra hệ thống</a>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.TraceId))
        {
            <p class="request-id">Trace ID: <code>@Model.TraceId</code></p>
        }
    </div>
    <div class="error-visual" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3 3 20h18L12 3Z"/><path d="M12 9v5M12 17h.01"/></svg>
    </div>
</section>
