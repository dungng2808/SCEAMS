@model SCEAMS.MVC.ViewModels.VenueScheduleViewModel

@{
    ViewData["Title"] = "Lịch sử dụng địa điểm";
}

<section class="clubs-page" aria-labelledby="venue-schedule-title">
    <header class="category-hero">
        <div class="category-hero__copy">
            <p class="eyebrow">Milestone G · Lịch sử dụng</p>
            <h1 id="venue-schedule-title">
                @(string.IsNullOrWhiteSpace(Model.VenueName) ? "Lịch địa điểm" : Model.VenueName)
            </h1>
            <p>@(string.IsNullOrWhiteSpace(Model.Location) ? "Theo dõi các Event sử dụng địa điểm." : Model.Location)</p>
        </div>
        <a class="btn-app btn-app--ghost" asp-action="Index">&larr; Danh sách địa điểm</a>
    </header>

    <form class="users-filters surface-card"
          asp-controller="Venues"
          asp-action="Schedule"
          asp-route-id="@Model.VenueId"
          method="get"
          aria-label="Khoảng thời gian lịch địa điểm">
        <div class="users-filter">
            <label for="from">Từ ngày</label>
            <input id="from" name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" />
        </div>
        <div class="users-filter">
            <label for="to">Đến ngày</label>
            <input id="to" name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")" />
        </div>
        <div class="users-filter__actions">
            <button type="submit" class="btn-app btn-app--primary">Xem lịch</button>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <section class="category-state category-state--error surface-card" role="alert">
            <span class="category-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v6M12 17h.01" />
                </svg>
            </span>
            <div>
                <p class="eyebrow">@(Model.IsNotFound ? "404 · Không tìm thấy" : "Không thể tải lịch")</p>
                <h2>@(Model.IsNotFound ? "Địa điểm không tồn tại" : "Khoảng thời gian chưa hợp lệ")</h2>
                <p>@Model.ErrorMessage</p>
            </div>
        </section>
    }
    else if (Model.Events.Count == 0)
    {
        <section class="category-state category-state--empty surface-card">
            <span class="category-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M8 3v4M16 3v4M3 10h18" />
                </svg>
            </span>
            <div>
                <p class="eyebrow">Không có lịch</p>
                <h2>Địa điểm đang trống trong khoảng đã chọn</h2>
                <p>Thử chọn một khoảng thời gian khác để kiểm tra các Event đã lên lịch.</p>
            </div>
        </section>
    }
    else
    {
        <section class="surface-card" style="padding: 0; overflow: hidden;" aria-labelledby="schedule-table-title">
            <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--sceams-border);">
                <p class="eyebrow">@Model.From.ToString("dd/MM/yyyy") - @Model.To.ToString("dd/MM/yyyy")</p>
                <h2 id="schedule-table-title" style="margin: 0;">@Model.Events.Count Event trong lịch</h2>
            </div>
            <div class="table-responsive">
                <table class="table align-middle style-table mb-0" style="width: 100%;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid var(--sceams-border);">
                            <th style="padding: 1rem 1.5rem;">Event</th>
                            <th>Trạng thái</th>
                            <th>Bắt đầu</th>
                            <th>Kết thúc</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var eventItem in Model.Events)
                        {
                            <tr style="border-bottom: 1px solid var(--sceams-border);">
                                <td style="padding: 1rem 1.5rem;">
                                    <strong>@eventItem.Title</strong>
                                    <small style="display: block; color: var(--sceams-text-soft);">#@eventItem.EventId</small>
                                </td>
                                <td><span class="status-badge">@eventItem.Status</span></td>
                                <td>@eventItem.StartTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@eventItem.EndTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</section>
