@model SCEAMS.MVC.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = Model.Heading;
}

<section class="dashboard-page" aria-labelledby="dashboard-title">
    <div class="dashboard-hero">
        <div>
            <p class="eyebrow">@Model.Role workspace</p>
            <h1 id="dashboard-title">@Model.Heading</h1>
            <p>@Model.Description</p>
        </div>
        <span class="dashboard-role">@Model.Role</span>
    </div>

    <div class="dashboard-grid">
        <article class="dashboard-card dashboard-card--identity">
            <span class="dashboard-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 21a8 8 0 0 1 16 0" />
                </svg>
            </span>
            <p class="dashboard-card__label">Phiên đăng nhập</p>
            <h2>@Model.FullName</h2>
            <p>@Model.Email</p>
            <div class="dashboard-security">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z" />
                    <path d="m9 12 2 2 4-4" />
                </svg>
                Token được mã hóa và tự làm mới khi access token hết hạn
            </div>
        </article>

        <article class="dashboard-card">
            <span class="dashboard-card__icon dashboard-card__icon--amber" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M12 3v18M3 12h18" />
                    <circle cx="12" cy="12" r="9" />
                </svg>
            </span>
            <p class="dashboard-card__label">Bước tiếp theo</p>
            <h2>Sẵn sàng mở rộng</h2>
            <p>@Model.NextStep</p>
            <a class="btn-app btn-app--primary"
               asp-controller="@Model.PrimaryController"
               asp-action="@Model.PrimaryAction">
                @Model.PrimaryActionText
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
            </a>
        </article>
    </div>

    <div class="dashboard-session-bar">
        <div>
            <strong>Muốn kết thúc phiên?</strong>
            <span>Đăng xuất sẽ revoke refresh token và xóa toàn bộ phiên cục bộ.</span>
        </div>
        <form asp-controller="Account"
              asp-action="Logout"
              method="post">
            <button class="btn-app btn-app--ghost" type="submit">
                Đăng xuất an toàn
            </button>
        </form>
    </div>
</section>
