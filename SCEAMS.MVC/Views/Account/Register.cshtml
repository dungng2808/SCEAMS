@model SCEAMS.MVC.ViewModels.RegisterViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng ký";
}

<div class="auth-shell auth-shell--register">
    <section class="auth-story auth-story--register" aria-labelledby="register-story-title">
        <a class="auth-brand" asp-controller="Home" asp-action="Index" aria-label="SCEAMS - Về trang chủ">
            <span class="auth-brand__mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M4 7.5 12 3l8 4.5-8 4.5-8-4.5Z" />
                    <path d="M7 10v5.5c2.8 2 7.2 2 10 0V10" />
                    <path d="M20 8v6" />
                </svg>
            </span>
            SCEAMS
        </a>

        <div class="auth-story__content">
            <p class="auth-story__eyebrow">Join the community</p>
            <h1 id="register-story-title">
                Một tài khoản. <em>Vô vàn trải nghiệm.</em>
            </h1>
            <p class="auth-story__lead">
                Tạo hồ sơ Student để sẵn sàng kết nối câu lạc bộ, đăng ký sự kiện và xây dựng hành trình ngoại khóa của riêng bạn.
            </p>

            <ul class="auth-benefits" aria-label="Lợi ích khi đăng ký">
                <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path d="m5 12 4 4L19 6" />
                    </svg>
                    Đăng ký nhanh với email sinh viên
                </li>
                <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z" />
                    </svg>
                    Mật khẩu luôn được hash an toàn
                </li>
                <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path d="M4 19V9M10 19V5M16 19v-7M22 19H2" />
                    </svg>
                    Theo dõi hành trình tập trung
                </li>
            </ul>
        </div>

        <p class="auth-story__footer">
            Student Club &amp; Extracurricular Activity Management System
        </p>
    </section>

    <section class="auth-panel auth-panel--register" aria-labelledby="register-title">
        <div class="auth-panel__top">
            <span>Đã có tài khoản?</span>
            <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
        </div>

        <div class="register-card">
            <span class="register-card__step">Student account · Bước 1/1</span>
            <h2 id="register-title">Tạo tài khoản sinh viên</h2>
            <p class="register-card__intro">
                Điền thông tin bên dưới. Các trường có dấu <span aria-hidden="true">*</span> là bắt buộc.
            </p>

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post"
                  novalidate
                  data-auth-form
                  data-loading-label="Đang tạo tài khoản...">
                <div asp-validation-summary="ModelOnly"
                     class="register-summary"
                     role="alert"
                     aria-live="polite"></div>

                <div class="register-grid">
                    <div class="register-field register-field--wide">
                        <label asp-for="FullName">
                            Họ và tên <span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <input asp-for="FullName"
                               class="form-control"
                               autocomplete="name"
                               placeholder="Nguyễn Văn An" />
                        <span asp-validation-for="FullName"
                              class="field-error"
                              role="alert"></span>
                    </div>

                    <div class="register-field">
                        <label asp-for="Email">
                            Email <span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="email"
                               placeholder="student@fpt.edu.vn" />
                        <span asp-validation-for="Email"
                              class="field-error"
                              role="alert"></span>
                    </div>

                    <div class="register-field">
                        <label asp-for="StudentCode">
                            Mã sinh viên <span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <input asp-for="StudentCode"
                               class="form-control"
                               autocomplete="off"
                               placeholder="SE123456" />
                        <span asp-validation-for="StudentCode"
                              class="field-error"
                              role="alert"></span>
                    </div>

                    <div class="register-field register-field--wide">
                        <label asp-for="PhoneNumber">Số điện thoại <small>Tùy chọn</small></label>
                        <input asp-for="PhoneNumber"
                               class="form-control"
                               autocomplete="tel"
                               placeholder="090 123 4567" />
                        <span asp-validation-for="PhoneNumber"
                              class="field-error"
                              role="alert"></span>
                    </div>

                    <div class="register-field">
                        <label asp-for="Password">
                            Mật khẩu <span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <div class="register-field__password">
                            <input asp-for="Password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Tạo mật khẩu mạnh" />
                            <button class="password-toggle"
                                    type="button"
                                    aria-label="Hiện mật khẩu"
                                    aria-pressed="false"
                                    data-password-toggle
                                    data-password-target="Password">
                                <svg data-eye-open viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg data-eye-closed viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="m3 3 18 18M10.6 10.7a2 2 0 0 0 2.7 2.7M9.9 4.2A10.8 10.8 0 0 1 12 4c6.5 0 10 8 10 8a18.5 18.5 0 0 1-2.1 3.2M6.6 6.6C3.6 8.5 2 12 2 12s3.5 8 10 8c1.6 0 3-.5 4.2-1.2" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password"
                              class="field-error"
                              role="alert"></span>
                    </div>

                    <div class="register-field">
                        <label asp-for="ConfirmPassword">
                            Xác nhận mật khẩu <span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <div class="register-field__password">
                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Nhập lại mật khẩu" />
                            <button class="password-toggle"
                                    type="button"
                                    aria-label="Hiện mật khẩu xác nhận"
                                    aria-pressed="false"
                                    data-password-toggle
                                    data-password-target="ConfirmPassword">
                                <svg data-eye-open viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg data-eye-closed viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="m3 3 18 18M10.6 10.7a2 2 0 0 0 2.7 2.7M9.9 4.2A10.8 10.8 0 0 1 12 4c6.5 0 10 8 10 8a18.5 18.5 0 0 1-2.1 3.2M6.6 6.6C3.6 8.5 2 12 2 12s3.5 8 10 8c1.6 0 3-.5 4.2-1.2" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword"
                              class="field-error"
                              role="alert"></span>
                    </div>
                </div>

                <p class="password-hint">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z" />
                    </svg>
                    Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.
                </p>

                <button type="submit"
                        class="register-submit"
                        data-submit-button>
                    <span data-submit-label>Tạo tài khoản</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                </button>
            </form>

            <p class="register-card__login">
                Bằng việc đăng ký, bạn đồng ý với
                <a asp-controller="Home" asp-action="Privacy">chính sách dữ liệu</a>
                của SCEAMS.
            </p>
        </div>

        <footer class="auth-panel__footer">
            <span>© 2026 SCEAMS</span>
            <a asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a>
        </footer>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
