@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<section class="error-page" aria-labelledby="access-denied-title">
    <div>
        <span class="error-page__code">403 · Forbidden</span>
        <h1 id="access-denied-title">Khu vực này cần quyền cao hơn.</h1>
        <p class="error-page__lead">
            Tài khoản hiện tại không được phép truy cập chức năng này.
            Nếu bạn cho rằng đây là nhầm lẫn, hãy liên hệ quản trị viên hệ thống.
        </p>

        <div class="error-page__actions">
            <a class="btn-app btn-app--primary"
               asp-controller="Dashboard"
               asp-action="Index">
                Về Dashboard
            </a>
            <a class="btn-app btn-app--ghost"
               asp-controller="Home"
               asp-action="Index">
                Về trang chủ
            </a>
        </div>
    </div>

    <div class="error-visual" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z" />
            <path d="M9 9l6 6M15 9l-6 6" />
        </svg>
    </div>
</section>
