@model ErrorViewModel

@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="error-page">
    <div>
        <span class="error-page__code">Error · 500</span>
        <h1>Đường truyền vừa gặp một nhịp gián đoạn.</h1>
        <p class="error-page__lead">
            Yêu cầu chưa thể hoàn thành. Bạn có thể thử lại, quay về trang chủ hoặc kiểm tra trạng thái hệ thống để tìm nguyên nhân.
        </p>

        <div class="error-page__actions">
            <a class="btn-app btn-app--primary"
               asp-controller="Home"
               asp-action="Index">
                Về trang chủ
            </a>
            <a class="btn-app btn-app--ghost"
               asp-controller="System"
               asp-action="Health">
                Kiểm tra hệ thống
            </a>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="request-id">
                Request ID:&nbsp;<code>@Model.RequestId</code>
            </p>
        }
    </div>

    <div class="error-visual" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M12 3 3 20h18L12 3Z" />
            <path d="M12 9v5M12 17h.01" />
        </svg>
    </div>
</div>
