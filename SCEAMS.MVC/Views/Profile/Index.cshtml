@model SCEAMS.MVC.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<section class="profile-page" aria-labelledby="profile-title">
    <div class="page-heading profile-heading">
        <div>
            <p class="eyebrow">Tài khoản của tôi</p>
            <h1 id="profile-title">Hồ sơ cá nhân</h1>
            <p class="page-heading__copy">
                Thông tin được tải trực tiếp từ SCEAMS API và chỉ thuộc về tài khoản đang đăng nhập.
            </p>
        </div>
        <div class="profile-heading__actions">
            @if (Model.Profile is not null)
            {
                <a class="btn-app btn-app--primary"
                   asp-controller="Profile"
                   asp-action="Edit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <path d="m4 16-.8 4 4-.8L18 8.4 15.6 6 4 16Z" />
                        <path d="m13.8 7.8 2.4 2.4" />
                    </svg>
                    Chỉnh sửa
                </a>
            }
            <a class="btn-app btn-app--ghost"
               asp-controller="Dashboard"
               asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path d="m15 18-6-6 6-6" />
                </svg>
                Dashboard
            </a>
        </div>
    </div>

    @if (TempData["ProfileUpdateSuccess"] is string updateSuccess)
    {
        <div class="profile-success" role="status" aria-live="polite">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="m8 12 2.5 2.5L16 9" />
            </svg>
            <div>
                <strong>Cập nhật thành công</strong>
                <p>@updateSuccess</p>
            </div>
        </div>
    }

    @if (Model.Profile is null)
    {
        <div class="profile-error surface-card" role="alert">
            <span class="profile-error__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v6M12 17h.01" />
                </svg>
            </span>
            <div>
                <h2>Chưa thể tải hồ sơ</h2>
                <p>@Model.ErrorMessage</p>
                <div class="profile-error__actions">
                    <a class="btn-app btn-app--primary"
                       asp-controller="Profile"
                       asp-action="Index">
                        Thử tải lại
                    </a>
                    <a class="btn-app btn-app--ghost"
                       asp-controller="System"
                       asp-action="Health">
                        Kiểm tra hệ thống
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        var profile = Model.Profile;

        <div class="profile-overview">
            <div class="profile-avatar" aria-hidden="true">
                @profile.Initials
            </div>
            <div class="profile-overview__identity">
                <p>Hồ sơ SCEAMS #@profile.Id</p>
                <h2>@profile.FullName</h2>
                <a href="mailto:@profile.Email">@profile.Email</a>
            </div>
            <div class="profile-overview__states" aria-label="Vai trò và trạng thái">
                <span class="profile-role">@profile.Role</span>
                <span class="state-pill @(profile.IsActive ? "state-pill--online" : "state-pill--offline")">
                    @(profile.IsActive ? "Đang hoạt động" : "Đã khóa")
                </span>
            </div>
        </div>

        <div class="profile-grid">
            <section class="profile-card surface-card" aria-labelledby="personal-info-title">
                <div class="profile-card__heading">
                    <span class="profile-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M4 21a8 8 0 0 1 16 0" />
                        </svg>
                    </span>
                    <div>
                        <p>Thông tin cơ bản</p>
                        <h2 id="personal-info-title">Thông tin cá nhân</h2>
                    </div>
                </div>

                <dl class="profile-details">
                    <div>
                        <dt>Họ và tên</dt>
                        <dd>@profile.FullName</dd>
                    </div>
                    <div>
                        <dt>Email</dt>
                        <dd>@profile.Email</dd>
                    </div>
                    <div>
                        <dt>Mã sinh viên</dt>
                        <dd class="@(profile.StudentCode is null ? "is-empty" : null)">
                            @(profile.StudentCode ?? "Không áp dụng")
                        </dd>
                    </div>
                    <div>
                        <dt>Số điện thoại</dt>
                        <dd class="@(profile.PhoneNumber is null ? "is-empty" : null)">
                            @(profile.PhoneNumber ?? "Chưa cập nhật")
                        </dd>
                    </div>
                </dl>
            </section>

            <aside class="profile-side">
                <section class="profile-card surface-card" aria-labelledby="account-info-title">
                    <div class="profile-card__heading">
                        <span class="profile-card__icon profile-card__icon--secure" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z" />
                                <path d="m9 12 2 2 4-4" />
                            </svg>
                        </span>
                        <div>
                            <p>Quyền truy cập</p>
                            <h2 id="account-info-title">Thông tin hệ thống</h2>
                        </div>
                    </div>

                    <dl class="profile-system-details">
                        <div>
                            <dt>Vai trò</dt>
                            <dd>@profile.Role</dd>
                        </div>
                        <div>
                            <dt>Trạng thái</dt>
                            <dd>@(profile.IsActive ? "Đang hoạt động" : "Đã khóa")</dd>
                        </div>
                        <div>
                            <dt>Ngày tham gia</dt>
                            <dd>
                                <time datetime="@profile.CreatedAtUtc.ToString("O")">
                                    @profile.CreatedAtLocal.ToString("dd/MM/yyyy · HH:mm")
                                </time>
                                <small>Giờ Việt Nam (UTC+7)</small>
                            </dd>
                        </div>
                    </dl>
                </section>

                <div class="profile-readonly-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <rect x="5" y="10" width="14" height="11" rx="2" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    </svg>
                    <div>
                        <strong>Vai trò và trạng thái được bảo vệ</strong>
                        <p>Bạn không thể thay đổi hai thông tin này từ hồ sơ cá nhân.</p>
                    </div>
                </div>
            </aside>
        </div>
    }
</section>
