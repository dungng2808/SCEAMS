@model SCEAMS.MVC.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<section class="profile-edit-page" aria-labelledby="profile-edit-title">
    <div class="page-heading profile-heading">
        <div>
            <p class="eyebrow">Tài khoản của tôi</p>
            <h1 id="profile-edit-title">Chỉnh sửa hồ sơ</h1>
            <p class="page-heading__copy">
                Cập nhật thông tin liên hệ mà không ảnh hưởng đến quyền truy cập tài khoản.
            </p>
        </div>
        <a class="btn-app btn-app--ghost"
           asp-controller="Profile"
           asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
            </svg>
            Quay lại hồ sơ
        </a>
    </div>

    @if (Model.LoadErrorMessage is not null)
    {
        <div class="profile-error surface-card" role="alert">
            <span class="profile-error__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v6M12 17h.01" />
                </svg>
            </span>
            <div>
                <h2>Chưa thể mở biểu mẫu</h2>
                <p>@Model.LoadErrorMessage</p>
                <div class="profile-error__actions">
                    <a class="btn-app btn-app--primary"
                       asp-controller="Profile"
                       asp-action="Edit">
                        Thử tải lại
                    </a>
                    <a class="btn-app btn-app--ghost"
                       asp-controller="System"
                       asp-action="Health">
                        Kiểm tra hệ thống
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="profile-edit-layout">
            <section class="profile-edit-card surface-card" aria-labelledby="editable-fields-title">
                <div class="profile-card__heading">
                    <span class="profile-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="m4 16-.8 4 4-.8L18 8.4 15.6 6 4 16Z" />
                            <path d="m13.8 7.8 2.4 2.4" />
                        </svg>
                    </span>
                    <div>
                        <p>Thông tin có thể sửa</p>
                        <h2 id="editable-fields-title">Thông tin cá nhân</h2>
                    </div>
                </div>

                <form asp-controller="Profile"
                      asp-action="Edit"
                      method="post"
                      novalidate
                      data-auth-form
                      data-loading-label="Đang lưu thay đổi...">
                    <div asp-validation-summary="ModelOnly"
                         class="profile-edit-summary"
                         role="alert"
                         aria-live="polite"></div>

                    <div class="profile-edit-fields">
                        <div class="profile-edit-field">
                            <label asp-for="FullName">
                                Họ và tên
                                <span class="required-mark" aria-hidden="true">*</span>
                            </label>
                            <div class="profile-edit-input">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <circle cx="12" cy="8" r="4" />
                                    <path d="M4 21a8 8 0 0 1 16 0" />
                                </svg>
                                <input asp-for="FullName"
                                       class="form-control"
                                       autocomplete="name"
                                       placeholder="Nguyễn Văn An" />
                            </div>
                            <span asp-validation-for="FullName"
                                  class="field-error"
                                  role="alert"></span>
                        </div>

                        <div class="profile-edit-field">
                            <label asp-for="PhoneNumber">
                                Số điện thoại
                                <small>Tùy chọn</small>
                            </label>
                            <div class="profile-edit-input">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="M7 3H4.5A1.5 1.5 0 0 0 3 4.5C3 13.6 10.4 21 19.5 21a1.5 1.5 0 0 0 1.5-1.5V17l-4-1-1.2 2a14 14 0 0 1-9.8-9.8L8 7 7 3Z" />
                                </svg>
                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       autocomplete="tel"
                                       inputmode="tel"
                                       placeholder="090 123 4567" />
                            </div>
                            <span asp-validation-for="PhoneNumber"
                                  class="field-error"
                                  role="alert"></span>
                            <p class="profile-edit-field__hint">
                                Để trống nếu bạn muốn xóa số điện thoại hiện tại.
                            </p>
                        </div>
                    </div>

                    <div class="profile-edit-actions">
                        <a class="btn-app btn-app--ghost"
                           asp-controller="Profile"
                           asp-action="Index">
                            Hủy
                        </a>
                        <button type="submit"
                                class="btn-app btn-app--primary profile-save-button"
                                data-submit-button>
                            <span data-submit-label>Lưu thay đổi</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                <path d="M5 12h14M13 6l6 6-6 6" />
                            </svg>
                        </button>
                    </div>
                </form>
            </section>

            <aside class="profile-edit-side" aria-label="Thông tin bảo mật">
                <section class="profile-edit-security surface-card">
                    <span class="profile-edit-security__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z" />
                            <path d="m9 12 2 2 4-4" />
                        </svg>
                    </span>
                    <h2>Các trường được bảo vệ</h2>
                    <p>
                        Email, mã sinh viên, vai trò và trạng thái tài khoản không được gửi trong biểu mẫu này.
                    </p>
                    <ul>
                        <li>API xác định tài khoản từ JWT hiện tại.</li>
                        <li>Role và trạng thái chỉ do quản trị viên thay đổi.</li>
                        <li>Mật khẩu được xử lý trong luồng riêng.</li>
                    </ul>
                </section>

                <div class="profile-edit-tip">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 11v5M12 8h.01" />
                    </svg>
                    <p>
                        Sau khi lưu, SCEAMS tải lại hồ sơ từ API để xác nhận dữ liệu thực sự đã được cập nhật.
                    </p>
                </div>
            </aside>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
