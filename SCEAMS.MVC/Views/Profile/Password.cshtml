@model SCEAMS.MVC.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="profile-edit-page" aria-labelledby="change-password-title">
    <div class="page-heading profile-heading">
        <div>
            <p class="eyebrow">Bảo mật tài khoản</p>
            <h1 id="change-password-title">Đổi mật khẩu</h1>
            <p class="page-heading__copy">
                Xác nhận mật khẩu hiện tại trước khi thiết lập thông tin đăng nhập mới.
            </p>
        </div>
        <a class="btn-app btn-app--ghost"
           asp-controller="Profile"
           asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
            </svg>
            Quay lại hồ sơ
        </a>
    </div>

    <div class="profile-edit-layout">
        <section class="profile-edit-card surface-card" aria-labelledby="password-form-title">
            <div class="profile-card__heading">
                <span class="profile-card__icon profile-card__icon--secure" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <rect x="5" y="10" width="14" height="11" rx="2" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    </svg>
                </span>
                <div>
                    <p>Xác minh danh tính</p>
                    <h2 id="password-form-title">Thông tin mật khẩu</h2>
                </div>
            </div>

            <form asp-controller="Profile"
                  asp-action="Password"
                  method="post"
                  novalidate
                  data-auth-form
                  data-loading-label="Đang đổi mật khẩu...">
                <div asp-validation-summary="ModelOnly"
                     class="profile-edit-summary"
                     role="alert"
                     aria-live="polite"></div>

                <div class="profile-edit-fields">
                    <div class="profile-edit-field">
                        <label asp-for="CurrentPassword">
                            Mật khẩu hiện tại
                            <span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <div class="profile-edit-input profile-password-input">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                <circle cx="8" cy="15" r="4" />
                                <path d="m11 12 8-8M16 7l2 2M14 9l2 2" />
                            </svg>
                            <input asp-for="CurrentPassword"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Nhập mật khẩu hiện tại" />
                            <button class="profile-password-toggle"
                                    type="button"
                                    aria-label="Hiện mật khẩu hiện tại"
                                    aria-pressed="false"
                                    data-password-toggle
                                    data-password-target="CurrentPassword">
                                <svg data-eye-open viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg data-eye-closed viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="m3 3 18 18M10.6 10.7a2 2 0 0 0 2.7 2.7M9.9 4.2A10.8 10.8 0 0 1 12 4c6.5 0 10 8 10 8a18.5 18.5 0 0 1-2.1 3.2M6.6 6.6C3.6 8.5 2 12 2 12s3.5 8 10 8c1.6 0 3-.5 4.2-1.2" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword"
                              class="field-error"
                              role="alert"></span>
                    </div>

                    <div class="profile-edit-field">
                        <label asp-for="NewPassword">
                            Mật khẩu mới
                            <span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <div class="profile-edit-input profile-password-input">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                <rect x="5" y="10" width="14" height="11" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />
                            </svg>
                            <input asp-for="NewPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Tạo mật khẩu mới" />
                            <button class="profile-password-toggle"
                                    type="button"
                                    aria-label="Hiện mật khẩu mới"
                                    aria-pressed="false"
                                    data-password-toggle
                                    data-password-target="NewPassword">
                                <svg data-eye-open viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg data-eye-closed viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="m3 3 18 18M10.6 10.7a2 2 0 0 0 2.7 2.7M9.9 4.2A10.8 10.8 0 0 1 12 4c6.5 0 10 8 10 8a18.5 18.5 0 0 1-2.1 3.2M6.6 6.6C3.6 8.5 2 12 2 12s3.5 8 10 8c1.6 0 3-.5 4.2-1.2" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword"
                              class="field-error"
                              role="alert"></span>
                    </div>

                    <div class="profile-edit-field">
                        <label asp-for="ConfirmPassword">
                            Xác nhận mật khẩu mới
                            <span class="required-mark" aria-hidden="true">*</span>
                        </label>
                        <div class="profile-edit-input profile-password-input">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z" />
                                <path d="m9 12 2 2 4-4" />
                            </svg>
                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Nhập lại mật khẩu mới" />
                            <button class="profile-password-toggle"
                                    type="button"
                                    aria-label="Hiện mật khẩu xác nhận"
                                    aria-pressed="false"
                                    data-password-toggle
                                    data-password-target="ConfirmPassword">
                                <svg data-eye-open viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg data-eye-closed viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="m3 3 18 18M10.6 10.7a2 2 0 0 0 2.7 2.7M9.9 4.2A10.8 10.8 0 0 1 12 4c6.5 0 10 8 10 8a18.5 18.5 0 0 1-2.1 3.2M6.6 6.6C3.6 8.5 2 12 2 12s3.5 8 10 8c1.6 0 3-.5 4.2-1.2" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword"
                              class="field-error"
                              role="alert"></span>
                    </div>
                </div>

                <div class="profile-password-policy">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 11v5M12 8h.01" />
                    </svg>
                    <p>
                        Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.
                    </p>
                </div>

                <div class="profile-edit-actions">
                    <a class="btn-app btn-app--ghost"
                       asp-controller="Profile"
                       asp-action="Index">
                        Hủy
                    </a>
                    <button type="submit"
                            class="btn-app btn-app--primary profile-save-button"
                            data-submit-button>
                        <span data-submit-label>Đổi mật khẩu</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" />
                        </svg>
                    </button>
                </div>
            </form>
        </section>

        <aside class="profile-edit-side" aria-label="Lưu ý bảo mật">
            <section class="profile-edit-security surface-card">
                <span class="profile-edit-security__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </span>
                <h2>Phiên đăng nhập sẽ kết thúc</h2>
                <p>
                    Sau khi đổi mật khẩu thành công, token trong Session và cookie đăng nhập hiện tại sẽ bị xóa.
                </p>
                <ul>
                    <li>Refresh token cũ đã được API vô hiệu hóa.</li>
                    <li>Bạn phải đăng nhập lại bằng mật khẩu mới.</li>
                    <li>Mật khẩu không bao giờ được lưu trong trình duyệt bởi SCEAMS.</li>
                </ul>
            </section>

            <div class="profile-edit-tip profile-edit-tip--warning">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path d="M12 3 2.5 20h19L12 3Z" />
                    <path d="M12 9v5M12 17h.01" />
                </svg>
                <p>
                    Không sử dụng lại mật khẩu đã chia sẻ hoặc đang dùng cho tài khoản khác.
                </p>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
