@model SCEAMS.MVC.ViewModels.DemoAccountsViewModel

@{
    ViewData["Title"] = "Tài khoản demo";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Development workspace</p>
        <h1>Tài khoản demo</h1>
        <p class="page-heading__copy">
            Danh sách email dùng để kiểm thử từng vai trò. Password không bao giờ được hiển thị trên giao diện.
        </p>
    </div>
    <a class="btn-app btn-app--ghost" asp-controller="System" asp-action="DemoAccounts">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="M20 7v5h-5M4 17v-5h5" />
            <path d="M6.1 9A7 7 0 0 1 18 6l2 2M17.9 15A7 7 0 0 1 6 18l-2-2" />
        </svg>
        Kiểm tra lại
    </a>
</header>

@if (Model.ErrorMessage is not null)
{
    <div class="demo-banner demo-banner--danger" role="alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8v5M12 16h.01" />
        </svg>
        <div>
            <strong>Không thể xác nhận seed</strong>
            <p>@Model.ErrorMessage</p>
        </div>
    </div>
}
else if (Model.DemoSeedReady)
{
    <div class="demo-banner demo-banner--success" role="status">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
        </svg>
        <div>
            <strong>Demo seed đã sẵn sàng</strong>
            <p>Database có đủ @Model.ExistingDemoAccountCount/4 tài khoản và dữ liệu demo liên quan.</p>
        </div>
    </div>
}
else
{
    <div class="demo-banner demo-banner--warning" role="alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="M12 3 3 20h18L12 3Z" />
            <path d="M12 9v5M12 17h.01" />
        </svg>
        <div>
            <strong>Demo seed chưa đầy đủ</strong>
            <p>Hiện tìm thấy @Model.ExistingDemoAccountCount/4 tài khoản. Hãy chạy lệnh seed trong README rồi kiểm tra lại.</p>
        </div>
    </div>
}

<div class="account-grid">
    @foreach (var account in Model.Accounts)
    {
        <article class="account-card">
            <span class="account-card__avatar" aria-hidden="true">@account.Role[0]</span>
            <div class="account-card__body">
                <span class="account-card__role">@account.Role</span>
                <h2>@account.Email</h2>
                <p>Thông tin đăng nhập an toàn · Không hiển thị password</p>
            </div>
        </article>
    }
</div>

<p class="dev-note">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z" />
    </svg>
    Trang này chỉ tồn tại trong môi trường Development và trả về 404 ở Production.
</p>
