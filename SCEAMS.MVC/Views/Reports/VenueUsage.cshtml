@model SCEAMS.MVC.ViewModels.VenueUsageReportViewModel

@{
    ViewData["Title"] = "Sử dụng Venue";
}

<section class="clubs-page" aria-labelledby="venue-usage-title">
    <header class="category-hero">
        <div class="category-hero__copy">
            <p class="eyebrow">Milestone J · Báo cáo và thống kê</p>
            <h1 id="venue-usage-title">Sử dụng Venue</h1>
            <p>Theo dõi tần suất và tổng thời lượng sử dụng từng địa điểm trong khoảng ngày đã chọn.</p>
        </div>
        <div class="category-hero__summary" aria-label="Số Venue trong báo cáo">
            <span>Venue trong báo cáo</span>
            <strong>@Model.Items.Count</strong>
            <small>Chỉ tính Event đã duyệt, đang diễn ra hoặc đã hoàn thành</small>
        </div>
    </header>

    <form class="users-filters surface-card" asp-controller="Reports" asp-action="VenueUsage" method="get" aria-label="Bộ lọc thời gian">
        <div class="users-filter">
            <label for="From">Từ ngày</label>
            <input id="From" name="from" type="date" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="users-filter">
            <label for="To">Đến ngày</label>
            <input id="To" name="to" type="date" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="users-filter__actions">
            <button type="submit" class="btn-app btn-app--primary">Lọc báo cáo</button>
            <a class="btn-app btn-app--ghost" asp-action="VenueUsage">Xóa lọc</a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="category-state category-state--error surface-card" role="alert">
            <span class="category-state__icon" aria-hidden="true">!</span>
            <div>
                <p class="eyebrow">Không thể tải báo cáo</p>
                <h2>Dữ liệu chưa sẵn sàng</h2>
                <p>@Model.ErrorMessage</p>
                <a class="btn-app btn-app--primary" asp-action="VenueUsage">Thử lại</a>
            </div>
        </div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="category-state category-state--empty surface-card" role="status">
            <span class="category-state__icon" aria-hidden="true">⌂</span>
            <div>
                <p class="eyebrow">Tập dữ liệu rỗng</p>
                <h2>Chưa có dữ liệu sử dụng Venue</h2>
                <p>Thử mở rộng khoảng ngày để xem thêm hoạt động.</p>
            </div>
        </div>
    }
    else
    {
        <section class="surface-card" style="padding: 0; overflow: hidden;" aria-labelledby="venue-usage-table-title">
            <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--sceams-border);">
                <p class="eyebrow">Phân bổ không gian</p>
                <h2 id="venue-usage-table-title" style="margin: 0; color: var(--sceams-navy-950);">@Model.Items.Count Venue được ghi nhận</h2>
            </div>
            <div class="table-responsive">
                <table class="table align-middle style-table mb-0" style="width: 100%;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid var(--sceams-border);">
                            <th style="padding: 1rem 1.5rem;">Venue</th>
                            <th>Vị trí</th>
                            <th class="text-end">Số Event</th>
                            <th class="text-end" style="padding-right: 1.5rem;">Tổng thời lượng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr style="border-bottom: 1px solid var(--sceams-border);">
                                <td style="padding: 1rem 1.5rem; min-width: 220px;">
                                    <strong>@item.VenueName</strong>
                                    <a asp-controller="Venues" asp-action="Schedule" asp-route-id="@item.VenueId" class="d-block small">Xem lịch Venue</a>
                                </td>
                                <td>@item.Location</td>
                                <td class="text-end"><strong>@item.EventCount</strong></td>
                                <td class="text-end" style="padding-right: 1.5rem;"><strong>@item.TotalHours.ToString("0.##") giờ</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</section>
