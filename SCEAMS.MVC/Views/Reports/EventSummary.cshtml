@model SCEAMS.MVC.ViewModels.EventSummaryReportViewModel

@{
    ViewData["Title"] = "Báo cáo Event";
}

<section class="clubs-page" aria-labelledby="event-summary-title">
    <header class="category-hero">
        <div class="category-hero__copy">
            <p class="eyebrow">Milestone J · Báo cáo và thống kê</p>
            <h1 id="event-summary-title">Tổng quan Event</h1>
            <p>Theo dõi số lượng Event theo trạng thái trong khoảng thời gian đã chọn.</p>
        </div>
        <div class="category-hero__summary" aria-label="Tổng số Event">
            <span>Tổng Event</span>
            <strong>@Model.TotalEvents</strong>
            <small>Dữ liệu từ API báo cáo</small>
        </div>
    </header>

    <form class="users-filters surface-card"
          asp-controller="Reports"
          asp-action="EventSummary"
          method="get"
          aria-label="Bộ lọc thời gian báo cáo Event">
        <div class="users-filter">
            <label for="From">Từ ngày</label>
            <input id="From" name="from" type="date" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="users-filter">
            <label for="To">Đến ngày</label>
            <input id="To" name="to" type="date" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="users-filter__actions">
            <button type="submit" class="btn-app btn-app--primary">Lọc báo cáo</button>
            <a class="btn-app btn-app--ghost" asp-action="EventSummary">Xóa lọc</a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="category-state category-state--error surface-card" role="alert">
            <span class="category-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9" /><path d="M12 7v6M12 17h.01" /></svg>
            </span>
            <div>
                <p class="eyebrow">Không thể tải báo cáo</p>
                <h2>Dữ liệu chưa sẵn sàng</h2>
                <p>@Model.ErrorMessage</p>
                <a class="btn-app btn-app--primary" asp-action="EventSummary">Thử lại</a>
            </div>
        </div>
    }
    else if (Model.TotalEvents == 0)
    {
        <div class="category-state category-state--empty surface-card" role="status">
            <span class="category-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" /></svg>
            </span>
            <div>
                <p class="eyebrow">Tập dữ liệu rỗng</p>
                <h2>Chưa có Event trong khoảng thời gian này</h2>
                <p>Thử mở rộng khoảng ngày để xem thêm dữ liệu.</p>
            </div>
        </div>
    }
    else
    {
        <section class="surface-card" style="padding: 0; overflow: hidden;" aria-labelledby="event-summary-table-title">
            <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--sceams-border);">
                <p class="eyebrow">Phân bổ trạng thái</p>
                <h2 id="event-summary-table-title" style="margin: 0; color: var(--sceams-navy-950);">@Model.TotalEvents Event được ghi nhận</h2>
            </div>
            <div class="table-responsive">
                <table class="table align-middle style-table mb-0" style="width: 100%;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid var(--sceams-border);">
                            <th style="padding: 1rem 1.5rem;">Trạng thái</th>
                            <th class="text-end" style="padding-right: 1.5rem;">Số lượng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr style="border-bottom: 1px solid var(--sceams-border);">
                                <td style="padding: 1rem 1.5rem;"><span class="status-badge @item.BadgeClass">@item.Status</span></td>
                                <td class="text-end" style="padding-right: 1.5rem;"><strong>@item.Count</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</section>
