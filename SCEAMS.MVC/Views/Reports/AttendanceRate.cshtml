@model SCEAMS.MVC.ViewModels.AttendanceRateReportViewModel

@{
    ViewData["Title"] = "Tỷ lệ tham dự";
    var canOpenRegistrations = User.IsInRole("Admin") || User.IsInRole("Organizer");
}

<section class="clubs-page" aria-labelledby="attendance-rate-title">
    <header class="category-hero">
        <div class="category-hero__copy">
            <p class="eyebrow">Milestone J · Báo cáo và thống kê</p>
            <h1 id="attendance-rate-title">Tỷ lệ tham dự</h1>
            <p>So sánh số người đăng ký hợp lệ với số lượt đã điểm danh theo từng Event.</p>
        </div>
        <div class="category-hero__summary" aria-label="Số Event trong báo cáo">
            <span>Event trong báo cáo</span>
            <strong>@Model.Items.Count</strong>
            <small>Event chưa có đăng ký vẫn hiển thị tỷ lệ 0%</small>
        </div>
    </header>

    <form class="users-filters surface-card" asp-controller="Reports" asp-action="AttendanceRate" method="get" aria-label="Bộ lọc thời gian">
        <div class="users-filter">
            <label for="From">Từ ngày</label>
            <input id="From" name="from" type="date" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="users-filter">
            <label for="To">Đến ngày</label>
            <input id="To" name="to" type="date" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="users-filter__actions">
            <button type="submit" class="btn-app btn-app--primary">Lọc báo cáo</button>
            <a class="btn-app btn-app--ghost" asp-action="AttendanceRate">Xóa lọc</a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="category-state category-state--error surface-card" role="alert">
            <span class="category-state__icon" aria-hidden="true">!</span>
            <div>
                <p class="eyebrow">Không thể tải báo cáo</p>
                <h2>Dữ liệu chưa sẵn sàng</h2>
                <p>@Model.ErrorMessage</p>
                <a class="btn-app btn-app--primary" asp-action="AttendanceRate">Thử lại</a>
            </div>
        </div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="category-state category-state--empty surface-card" role="status">
            <span class="category-state__icon" aria-hidden="true">∅</span>
            <div>
                <p class="eyebrow">Tập dữ liệu rỗng</p>
                <h2>Chưa có Event trong khoảng thời gian này</h2>
                <p>Thử mở rộng khoảng ngày để xem tỷ lệ tham dự.</p>
            </div>
        </div>
    }
    else
    {
        <section class="surface-card" style="padding: 0; overflow: hidden;" aria-labelledby="attendance-rate-table-title">
            <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--sceams-border);">
                <p class="eyebrow">Theo dõi điểm danh</p>
                <h2 id="attendance-rate-table-title" style="margin: 0; color: var(--sceams-navy-950);">@Model.Items.Count Event được ghi nhận</h2>
            </div>
            <div class="table-responsive">
                <table class="table align-middle style-table mb-0" style="width: 100%;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid var(--sceams-border);">
                            <th style="padding: 1rem 1.5rem;">Event</th>
                            <th>Thời gian</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Đăng ký</th>
                            <th class="text-end">Đã điểm danh</th>
                            <th class="text-end" style="padding-right: 1.5rem;">Tỷ lệ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr style="border-bottom: 1px solid var(--sceams-border);">
                                <td style="padding: 1rem 1.5rem; min-width: 220px;">
                                    <strong>@item.EventTitle</strong>
                                    <small class="d-block text-muted">@item.ClubName</small>
                                    @if (canOpenRegistrations)
                                    {
                                        <a asp-controller="Events" asp-action="Registrations" asp-route-eventId="@item.EventId" class="small">Xem registrations</a>
                                    }
                                </td>
                                <td>@item.StartTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="status-badge @item.BadgeClass">@item.Status</span></td>
                                <td class="text-end"><strong>@item.RegisteredCount</strong></td>
                                <td class="text-end"><strong>@item.AttendedCount</strong></td>
                                <td class="text-end" style="padding-right: 1.5rem;"><strong>@item.AttendanceRate.ToString("0.##")%</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</section>
