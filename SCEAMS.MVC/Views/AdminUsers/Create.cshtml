@model SCEAMS.MVC.ViewModels.CreateAdminUserViewModel

@{
    ViewData["Title"] = "Tạo tài khoản";
}

<section class="profile-edit-page user-create-page" aria-labelledby="user-create-title">
    <div class="page-heading profile-heading">
        <div>
            <p class="eyebrow">Milestone C · Admin</p>
            <h1 id="user-create-title">Tạo tài khoản mới</h1>
            <p class="page-heading__copy">
                Thiết lập thông tin, quyền truy cập và mật khẩu ban đầu cho người dùng SCEAMS.
            </p>
        </div>
        <a class="btn-app btn-app--ghost"
           asp-controller="AdminUsers"
           asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
            </svg>
            Quay lại danh sách
        </a>
    </div>

    <div class="profile-edit-layout user-create-layout">
        <section class="profile-edit-card surface-card" aria-labelledby="user-create-form-title">
            <div class="profile-card__heading">
                <span class="profile-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <circle cx="9" cy="8" r="3" />
                        <path d="M3 19a6 6 0 0 1 12 0M17 8h4M19 6v4" />
                    </svg>
                </span>
                <div>
                    <p>Thông tin bắt buộc</p>
                    <h2 id="user-create-form-title">Hồ sơ tài khoản</h2>
                </div>
            </div>

            <form asp-controller="AdminUsers"
                  asp-action="Create"
                  method="post"
                  novalidate
                  data-auth-form
                  data-loading-label="Đang tạo tài khoản...">
                <div asp-validation-summary="ModelOnly"
                     class="profile-edit-summary"
                     role="alert"
                     aria-live="polite"></div>

                <fieldset class="user-create-section">
                    <legend>Thông tin cá nhân</legend>
                    <div class="profile-edit-fields user-create-fields">
                        <div class="profile-edit-field user-create-field--wide">
                            <label asp-for="FullName">
                                Họ và tên
                                <span class="required-mark" aria-hidden="true">*</span>
                            </label>
                            <div class="profile-edit-input">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <circle cx="12" cy="8" r="4" />
                                    <path d="M4 21a8 8 0 0 1 16 0" />
                                </svg>
                                <input asp-for="FullName"
                                       class="form-control"
                                       autocomplete="name"
                                       placeholder="Nguyễn Văn An" />
                            </div>
                            <span asp-validation-for="FullName"
                                  class="field-error"
                                  role="alert"></span>
                        </div>

                        <div class="profile-edit-field">
                            <label asp-for="Email">
                                Email
                                <span class="required-mark" aria-hidden="true">*</span>
                            </label>
                            <div class="profile-edit-input">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14" rx="2" />
                                    <path d="m4 7 8 6 8-6" />
                                </svg>
                                <input asp-for="Email"
                                       class="form-control"
                                       autocomplete="email"
                                       inputmode="email"
                                       placeholder="user@sceams.edu.vn" />
                            </div>
                            <span asp-validation-for="Email"
                                  class="field-error"
                                  role="alert"></span>
                        </div>

                        <div class="profile-edit-field">
                            <label asp-for="PhoneNumber">
                                Số điện thoại
                                <small>Tùy chọn</small>
                            </label>
                            <div class="profile-edit-input">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="M7 3H4.5A1.5 1.5 0 0 0 3 4.5C3 13.6 10.4 21 19.5 21a1.5 1.5 0 0 0 1.5-1.5V17l-4-1-1.2 2a14 14 0 0 1-9.8-9.8L8 7 7 3Z" />
                                </svg>
                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       autocomplete="tel"
                                       inputmode="tel"
                                       placeholder="090 123 4567" />
                            </div>
                            <span asp-validation-for="PhoneNumber"
                                  class="field-error"
                                  role="alert"></span>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="user-create-section">
                    <legend>Quyền truy cập</legend>
                    <div class="profile-edit-fields user-create-fields">
                        <div class="profile-edit-field">
                            <label asp-for="Role">
                                Vai trò
                                <span class="required-mark" aria-hidden="true">*</span>
                            </label>
                            <div class="profile-edit-input">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z" />
                                    <path d="m9 12 2 2 4-4" />
                                </svg>
                                <select asp-for="Role" class="form-control">
                                    <option value="Admin">Quản trị viên</option>
                                    <option value="Staff">Cán bộ</option>
                                    <option value="Organizer">Nhà tổ chức</option>
                                    <option value="Student">Sinh viên</option>
                                </select>
                            </div>
                            <span asp-validation-for="Role"
                                  class="field-error"
                                  role="alert"></span>
                        </div>

                        <div class="profile-edit-field">
                            <label asp-for="StudentCode">
                                Mã sinh viên
                                <small>Khi chọn Sinh viên</small>
                            </label>
                            <div class="profile-edit-input">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14" rx="2" />
                                    <path d="M7 9h4M7 13h7M17 9h.01" />
                                </svg>
                                <input asp-for="StudentCode"
                                       class="form-control"
                                       autocomplete="off"
                                       placeholder="SE123456" />
                            </div>
                            <span asp-validation-for="StudentCode"
                                  class="field-error"
                                  role="alert"></span>
                            <p class="profile-edit-field__hint">
                                Bắt buộc và duy nhất nếu vai trò là Sinh viên.
                            </p>
                        </div>
                    </div>

                    <label class="user-create-status" asp-for="IsActive">
                        <input asp-for="IsActive" />
                        <span class="user-create-status__toggle" aria-hidden="true"></span>
                        <span>
                            <strong>Kích hoạt tài khoản ngay</strong>
                            <small>Người dùng có thể đăng nhập sau khi nhận mật khẩu.</small>
                        </span>
                    </label>
                </fieldset>

                <fieldset class="user-create-section">
                    <legend>Mật khẩu ban đầu</legend>
                    <div class="profile-edit-fields user-create-fields">
                        <div class="profile-edit-field">
                            <label asp-for="Password">
                                Mật khẩu
                                <span class="required-mark" aria-hidden="true">*</span>
                            </label>
                            <div class="profile-edit-input profile-password-input">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <rect x="5" y="10" width="14" height="11" rx="2" />
                                    <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />
                                </svg>
                                <input asp-for="Password"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Tạo mật khẩu ban đầu" />
                                <button class="profile-password-toggle"
                                        type="button"
                                        aria-label="Hiện mật khẩu"
                                        aria-pressed="false"
                                        data-password-toggle
                                        data-password-target="Password">
                                    <svg data-eye-open viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                    <svg data-eye-closed viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="m3 3 18 18M10.6 10.7a2 2 0 0 0 2.7 2.7M9.9 4.2A10.8 10.8 0 0 1 12 4c6.5 0 10 8 10 8a18.5 18.5 0 0 1-2.1 3.2M6.6 6.6C3.6 8.5 2 12 2 12s3.5 8 10 8c1.6 0 3-.5 4.2-1.2" />
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="Password"
                                  class="field-error"
                                  role="alert"></span>
                        </div>

                        <div class="profile-edit-field">
                            <label asp-for="ConfirmPassword">
                                Xác nhận mật khẩu
                                <span class="required-mark" aria-hidden="true">*</span>
                            </label>
                            <div class="profile-edit-input profile-password-input">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                    <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z" />
                                    <path d="m9 12 2 2 4-4" />
                                </svg>
                                <input asp-for="ConfirmPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Nhập lại mật khẩu" />
                                <button class="profile-password-toggle"
                                        type="button"
                                        aria-label="Hiện mật khẩu xác nhận"
                                        aria-pressed="false"
                                        data-password-toggle
                                        data-password-target="ConfirmPassword">
                                    <svg data-eye-open viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                    <svg data-eye-closed viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="m3 3 18 18M10.6 10.7a2 2 0 0 0 2.7 2.7M9.9 4.2A10.8 10.8 0 0 1 12 4c6.5 0 10 8 10 8a18.5 18.5 0 0 1-2.1 3.2M6.6 6.6C3.6 8.5 2 12 2 12s3.5 8 10 8c1.6 0 3-.5 4.2-1.2" />
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword"
                                  class="field-error"
                                  role="alert"></span>
                        </div>
                    </div>

                    <div class="profile-password-policy">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 11v5M12 8h.01" />
                        </svg>
                        <p>
                            Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.
                        </p>
                    </div>
                </fieldset>

                <div class="profile-edit-actions">
                    <a class="btn-app btn-app--ghost"
                       asp-controller="AdminUsers"
                       asp-action="Index">
                        Hủy
                    </a>
                    <button type="submit"
                            class="btn-app btn-app--primary profile-save-button"
                            data-submit-button>
                        <span data-submit-label>Tạo tài khoản</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" />
                        </svg>
                    </button>
                </div>
            </form>
        </section>

        <aside class="profile-edit-side" aria-label="Hướng dẫn tạo tài khoản">
            <section class="profile-edit-security surface-card">
                <span class="profile-edit-security__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M12 3 4 7v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V7l-8-4Z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </span>
                <h2>Chọn đúng vai trò</h2>
                <p>
                    Vai trò quyết định phạm vi tính năng mà người dùng có thể truy cập.
                </p>
                <ul>
                    <li>Admin quản trị tài khoản và cấu hình hệ thống.</li>
                    <li>Staff hỗ trợ các nghiệp vụ vận hành.</li>
                    <li>Organizer phụ trách tạo và quản lý sự kiện.</li>
                    <li>Student đăng ký và tham gia sự kiện.</li>
                </ul>
            </section>

            <div class="profile-edit-tip">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 11v5M12 8h.01" />
                </svg>
                <p>
                    Sau khi tạo thành công, SCEAMS quay về danh sách và tự tìm theo email để bạn xác nhận tài khoản đã xuất hiện.
                </p>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
