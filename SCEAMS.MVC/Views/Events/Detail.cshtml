@model SCEAMS.MVC.ViewModels.EventDetailViewModel

@{
    ViewData["Title"] = Model.IsNotFound ? "Không tìm thấy Event" : Model.Title;
}

<section class="profile-page" aria-labelledby="event-detail-title">
    <div class="profile-page__header">
        <div>
            <p class="eyebrow">Milestone H · Chi tiết sự kiện</p>
            <h1 id="event-detail-title">@(Model.IsNotFound ? "Event không tồn tại" : Model.Title)</h1>
            @if (!Model.IsNotFound)
            {
                <p>Thông tin Event #@Model.Id, quyền thao tác được quyết định bởi API.</p>
            }
        </div>
        <a class="btn-app btn-app--ghost" asp-action="Index">&larr; Danh sách sự kiện</a>
    </div>

    @if (Model.IsNotFound || !string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <section class="category-state category-state--error surface-card" role="alert">
            <span class="category-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v6M12 17h.01" />
                </svg>
            </span>
            <div>
                <p class="eyebrow">@(Model.IsNotFound ? "404 · Không tìm thấy" : "Kết nối gián đoạn")</p>
                <h2>@(Model.IsNotFound ? "Bạn không có quyền xem Event này" : "Chưa thể tải chi tiết Event")</h2>
                <p>@Model.ErrorMessage</p>
                <a class="btn-app btn-app--primary" asp-action="Index">Quay lại danh sách</a>
            </div>
        </section>
    }
    else
    {
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }
        @if (TempData["EventErrorMessage"] is string eventErrorMessage)
        {
            <div class="alert alert-danger" role="alert">@eventErrorMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.NotificationCorrelationId))
        {
            <div class="alert @(Model.NotificationDelivered == true ? "alert-success" : "alert-warning")" role="status">
                <strong>Notification correlation:</strong> <code>@Model.NotificationCorrelationId</code>
                @if (Model.NotificationDelivered != true && !string.IsNullOrWhiteSpace(Model.NotificationError))
                {
                    <span> · @Model.NotificationError</span>
                }
            </div>
        }
        <div class="profile-layout">
            <section class="surface-card profile-form" aria-labelledby="event-overview-title">
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
                    <div>
                        <p class="eyebrow">Trạng thái hiện tại</p>
                        <h2 id="event-overview-title" style="margin: 0;">@Model.Title</h2>
                    </div>
                    <span class="status-badge @Model.StatusClass">@Model.Status</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p style="margin-top: 1.25rem;">@Model.Description</p>
                }

                <dl class="detail-list" style="margin-top: 1.5rem;">
                    <div><dt>Club</dt><dd>@Model.ClubName</dd></div>
                    <div><dt>Địa điểm</dt><dd>@Model.VenueName · @Model.VenueLocation</dd></div>
                    <div><dt>Thời gian</dt><dd>@Model.StartTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm") - @Model.EndTime.ToLocalTime().ToString("HH:mm")</dd></div>
                    <div><dt>Hạn đăng ký</dt><dd>@Model.RegistrationDeadline.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
                    <div><dt>Người tạo</dt><dd>@Model.CreatedByUserName</dd></div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                {
                    <div class="alert alert-danger" role="status"><strong>Lý do từ chối:</strong> @Model.RejectionReason</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                {
                    <div class="alert alert-danger" role="status"><strong>Lý do hủy:</strong> @Model.CancellationReason</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CurrentRegistrationStatus))
                {
                    <div class="alert alert-success" role="status" style="margin-top: 1.25rem;">
                        Bạn đã đăng ký Event này. Trạng thái đăng ký: <strong>@Model.CurrentRegistrationStatus</strong>.
                    </div>
                }

                @if (string.Equals(Model.Status, "Ongoing", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="alert alert-info" role="status" style="margin-top: 1.25rem;">
                        <strong>Event đang diễn ra.</strong>
                        <p style="margin: .35rem 0 0;">Khu vực điểm danh chỉ khả dụng trong thời gian Ongoing cho người đã đăng ký.</p>
                    </div>
                }
                else if (string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="alert alert-success" role="status" style="margin-top: 1.25rem;">
                        <strong>Event đã hoàn tất.</strong>
                        <p style="margin: .35rem 0 0;">Feedback sẽ được mở sau khi hệ thống xác nhận trạng thái điểm danh.</p>
                    </div>
                }
            </section>

            <aside class="surface-card profile-aside" aria-label="Sức chứa và quyền thao tác">
                <p class="eyebrow">Sức chứa</p>
                <h2>@Model.SlotsRemaining / @Model.Capacity</h2>
                <p>@Model.RegisteredCount đăng ký hợp lệ đã được ghi nhận.</p>

                <p class="eyebrow" style="margin-top: 1.5rem;">Action khả dụng</p>
                <ul>
                    @if (Model.Permissions.CanRegister) { <li>Đăng ký Event</li> }
                    @if (Model.Permissions.CanEdit) { <li>Chỉnh sửa thông tin</li> }
                    @if (Model.Permissions.CanSubmit) { <li>Gửi duyệt</li> }
                    @if (Model.Permissions.CanApprove) { <li>Duyệt Event</li> }
                    @if (Model.Permissions.CanReject) { <li>Từ chối Event</li> }
                    @if (Model.Permissions.CanCancel) { <li>Hủy Event</li> }
                    @if (!Model.Permissions.CanRegister && !Model.Permissions.CanEdit && !Model.Permissions.CanSubmit && !Model.Permissions.CanApprove && !Model.Permissions.CanReject && !Model.Permissions.CanCancel)
                    {
                        <li>Không có action khả dụng ở trạng thái hiện tại.</li>
                    }
                </ul>
                @if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
                {
                    <a class="btn-app btn-app--ghost" asp-controller="Events" asp-action="Registrations" asp-route-eventId="@Model.Id" style="margin-top:.75rem;">Danh sách người đăng ký</a>
                }
                @if (Model.Permissions.CanEdit)
                {
                    <a class="btn-app btn-app--primary" asp-controller="Events" asp-action="Edit" asp-route-id="@Model.Id">Chỉnh sửa Event</a>
                }
                @if (Model.Permissions.CanSubmit)
                {
                    <form asp-controller="Events" asp-action="Submit" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Gửi Event này để Admin/Staff duyệt?');" style="margin-top: .75rem;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-app btn-app--primary">Gửi để duyệt</button>
                    </form>
                }
                @if (Model.Permissions.CanRegister)
                {
                    <form asp-controller="Events" asp-action="Register" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Xác nhận đăng ký Event này?');" style="margin-top: .75rem;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-app btn-app--primary">Đăng ký Event</button>
                    </form>
                }
                @if (Model.CurrentRegistrationStatus == "Confirmed" && Model.CurrentRegistrationId.HasValue)
                {
                    <form asp-controller="Events" asp-action="CancelRegistration" asp-route-registrationId="@Model.CurrentRegistrationId" asp-route-eventId="@Model.Id" method="post" onsubmit="return confirm('Xác nhận hủy registration?');" style="margin-top: .75rem;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-app btn-app--ghost" style="color: var(--sceams-danger);">Hủy đăng ký</button>
                    </form>
                    <small style="display:block;margin-top:.5rem;color:var(--sceams-text-soft);">Hạn hủy: @Model.StartTime.AddHours(-24).ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                }
                @if (Model.CanFeedback)
                {
                    <form asp-controller="Events" asp-action="Feedback" asp-route-id="@Model.Id" method="post" style="margin-top:1.25rem;">
                        @Html.AntiForgeryToken()
                        <p class="eyebrow">Feedback Event</p>
                        <label for="feedback-rating" style="display:block;font-weight:700;margin:.35rem 0;">Rating</label>
                        <select id="feedback-rating" name="Rating" required class="form-control" style="width:100%;padding:.6rem;border:1px solid var(--sceams-border);border-radius:var(--sceams-radius-sm);">
                            <option value="">Chọn rating</option>
                            @for (var rating = 5; rating >= 1; rating--)
                            {
                                <option value="@rating">@rating / 5</option>
                            }
                        </select>
                        <label for="feedback-comment" style="display:block;font-weight:700;margin:.65rem 0 .35rem;">Nhận xét</label>
                        <textarea id="feedback-comment" name="Comment" rows="3" maxlength="2000" class="form-control" placeholder="Chia sẻ trải nghiệm của bạn..." style="width:100%;padding:.6rem;border:1px solid var(--sceams-border);border-radius:var(--sceams-radius-sm);font-family:inherit;resize:vertical;"></textarea>
                        <button type="submit" class="btn-app btn-app--primary" style="margin-top:.75rem;">Gửi feedback</button>
                    </form>
                }
                else if (Model.CurrentFeedback is not null)
                {
                    <div class="alert alert-success" role="status" style="margin-top:1.25rem;">
                        <strong>Feedback đã gửi · @Model.CurrentFeedback.Rating/5</strong>
                        @if (!string.IsNullOrWhiteSpace(Model.CurrentFeedback.Comment))
                        {
                            <p style="margin:.35rem 0 0;">@Model.CurrentFeedback.Comment</p>
                        }
                    </div>
                }
                @if (Model.Permissions.CanApprove)
                {
                    <form asp-controller="Events" asp-action="Approve" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Duyệt Event này? API sẽ kiểm tra overlap Venue.');" style="margin-top: .75rem;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-app btn-app--primary">Approve Event</button>
                    </form>
                }
                @if (Model.Permissions.CanReject)
                {
                    <button type="button" class="btn-app btn-app--ghost" style="margin-top: .75rem; color: var(--sceams-danger);" onclick="document.getElementById('rejectEventModal').showModal();">Từ chối Event</button>
                    <dialog id="rejectEventModal" class="surface-card" style="padding: 1.75rem; border-radius: var(--sceams-radius-md); border: 1px solid var(--sceams-border); max-width: 34rem; width: 90vw; margin: auto;">
                        <form asp-controller="Events" asp-action="Reject" asp-route-id="@Model.Id" method="post" onsubmit="var reason = this.Reason.value.trim(); if (!reason) { alert('Vui lòng nhập lý do từ chối.'); return false; } return confirm('Xác nhận từ chối Event này?');">
                            @Html.AntiForgeryToken()
                            <h3 style="margin-top: 0; color: var(--sceams-danger); font-size: 1.25rem;">Từ chối Event</h3>
                            <p style="font-size: .9rem; color: var(--sceams-text-soft);">Lý do sẽ được lưu để Organizer xem lại.</p>
                            <label for="event-rejection-reason" style="display:block;font-weight:700;margin:.75rem 0 .35rem;">Lý do từ chối <span style="color:var(--sceams-danger);">*</span></label>
                            <textarea id="event-rejection-reason" name="Reason" rows="4" required minlength="2" maxlength="500" class="form-control" placeholder="Nhập lý do cụ thể..." style="width:100%;padding:.75rem;border-radius:var(--sceams-radius-sm);border:1px solid var(--sceams-border);font-family:inherit;resize:vertical;"></textarea>
                            <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1rem;">
                                <button type="button" class="btn-app btn-app--ghost" onclick="document.getElementById('rejectEventModal').close();">Hủy bỏ</button>
                                <button type="submit" class="btn-app btn-app--primary" style="background:var(--sceams-danger);border-color:var(--sceams-danger);">Xác nhận từ chối</button>
                            </div>
                        </form>
                    </dialog>
                }
                @if (Model.Permissions.CanCancel)
                {
                    <button type="button" class="btn-app btn-app--ghost" style="margin-top: .75rem; color: var(--sceams-danger);" onclick="document.getElementById('cancelEventModal').showModal();">Hủy Event</button>
                    <dialog id="cancelEventModal" class="surface-card" style="padding: 1.75rem; border-radius: var(--sceams-radius-md); border: 1px solid var(--sceams-border); max-width: 34rem; width: 90vw; margin: auto;">
                        <form asp-controller="Events" asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="var reason = this.Reason.value.trim(); if (!reason) { alert('Vui lòng nhập lý do hủy.'); return false; } return confirm('Event có @Model.RegisteredCount người đăng ký hợp lệ. Xác nhận hủy?');">
                            @Html.AntiForgeryToken()
                            <h3 style="margin-top: 0; color: var(--sceams-danger); font-size: 1.25rem;">Hủy Event</h3>
                            <p style="font-size: .9rem; color: var(--sceams-text-soft);">Hành động này giữ lại Event và đăng ký, nhưng chuyển trạng thái sang Cancelled.</p>
                            <div class="alert alert-warning" role="note" style="margin: .75rem 0;">@Model.RegisteredCount người đã đăng ký hợp lệ sẽ được giữ trong lịch sử.</div>
                            <label for="event-cancellation-reason" style="display:block;font-weight:700;margin:.75rem 0 .35rem;">Lý do hủy <span style="color:var(--sceams-danger);">*</span></label>
                            <textarea id="event-cancellation-reason" name="Reason" rows="4" required minlength="2" maxlength="500" class="form-control" placeholder="Nhập lý do cụ thể..." style="width:100%;padding:.75rem;border-radius:var(--sceams-radius-sm);border:1px solid var(--sceams-border);font-family:inherit;resize:vertical;"></textarea>
                            <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1rem;">
                                <button type="button" class="btn-app btn-app--ghost" onclick="document.getElementById('cancelEventModal').close();">Giữ lại</button>
                                <button type="submit" class="btn-app btn-app--primary" style="background:var(--sceams-danger);border-color:var(--sceams-danger);">Xác nhận hủy</button>
                            </div>
                        </form>
                    </dialog>
                }
                @if (string.Equals(Model.Status, "Ongoing", StringComparison.OrdinalIgnoreCase))
                {
                    <button type="button" class="btn-app btn-app--ghost" style="margin-top: .75rem;" disabled aria-disabled="true">Check-in (dành cho người đăng ký)</button>
                }
                else if (string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                {
                    <button type="button" class="btn-app btn-app--ghost" style="margin-top: .75rem;" disabled aria-disabled="true">Feedback sau điểm danh</button>
                }
            </aside>
        </div>
        <section class="surface-card" style="margin-top:1.25rem;" aria-labelledby="feedback-summary-title">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;">
                <div>
                    <p class="eyebrow">Cộng đồng đánh giá</p>
                    <h2 id="feedback-summary-title" style="margin:0;">Feedback Event</h2>
                </div>
                <strong style="font-size:1.5rem;">@(Model.TotalFeedback == 0 ? "—" : $"{Model.AverageRating:0.##}/5")</strong>
            </div>
            @if (Model.TotalFeedback == 0)
            {
                <p style="margin-bottom:0;color:var(--sceams-text-soft);">Chưa có feedback. Hãy là người đầu tiên chia sẻ trải nghiệm.</p>
            }
            else
            {
                <p style="color:var(--sceams-text-soft);">@Model.TotalFeedback feedback</p>
                <div style="display:grid;gap:.75rem;">
                    @foreach (var feedback in Model.Feedbacks)
                    {
                        <article style="padding:.85rem 0;border-top:1px solid var(--sceams-border);">
                            <strong>@feedback.Rating/5</strong>
                            <small style="color:var(--sceams-text-soft);margin-left:.5rem;">@feedback.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                            @if (!string.IsNullOrWhiteSpace(feedback.Comment))
                            {
                                <p style="margin:.35rem 0 0;">@feedback.Comment</p>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    }
</section>
