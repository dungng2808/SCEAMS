@model SCEAMS.MVC.ViewModels.EventsViewModel

@{
    ViewData["Title"] = "Danh sách sự kiện";
    var statuses = new[] { "", "Draft", "PendingApproval", "Approved", "Ongoing", "Completed", "Cancelled", "Rejected" };
}

<section class="clubs-page" aria-labelledby="events-title">
    <header class="category-hero">
        <div class="category-hero__copy">
            <p class="eyebrow">Milestone H · Sự kiện và workflow</p>
            <h1 id="events-title">Lịch hoạt động của câu lạc bộ</h1>
            <p>Tìm kiếm Event theo Club, thời gian, trạng thái và số chỗ còn lại.</p>
        </div>
        <div class="category-hero__summary" aria-label="Tổng quan sự kiện">
            <span>Event phù hợp</span>
            <strong>@Model.TotalItems</strong>
            <small>OData · StartTime tăng dần</small>
        </div>
    </header>

    <form class="users-filters surface-card"
          asp-controller="Events"
          asp-action="Index"
          method="get"
          aria-label="Bộ lọc danh sách sự kiện">
        <div class="users-filter users-filter--search">
            <label for="Search">Từ khóa</label>
            <div class="users-filter__control">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m16 16 4 4" />
                </svg>
                <input id="Search" name="search" type="search" value="@Model.Search" placeholder="Tên Event, Club hoặc địa điểm..." />
            </div>
        </div>
        <div class="users-filter">
            <label for="ClubId">Mã Club</label>
            <input id="ClubId" name="clubId" type="number" min="1" value="@Model.ClubId" placeholder="Tất cả Club" />
        </div>
        <div class="users-filter">
            <label for="Status">Trạng thái</label>
            <select id="Status" name="status">
                @foreach (var option in statuses)
                {
                    <option value="@option" selected="@(string.Equals(Model.Status, option, StringComparison.OrdinalIgnoreCase))">
                        @(string.IsNullOrEmpty(option) ? "Tất cả trạng thái" : option)
                    </option>
                }
            </select>
        </div>
        <div class="users-filter">
            <label for="From">Từ ngày</label>
            <input id="From" name="from" type="date" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="users-filter">
            <label for="To">Đến ngày</label>
            <input id="To" name="to" type="date" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="users-filter">
            <label for="HasSlots">Số chỗ</label>
            <select id="HasSlots" name="hasSlots">
                <option value="" selected="@(!Model.HasSlots.HasValue)">Tất cả</option>
                <option value="true" selected="@(Model.HasSlots == true)">Còn chỗ</option>
                <option value="false" selected="@(Model.HasSlots == false)">Đã đủ chỗ</option>
            </select>
        </div>
        <div class="users-filter__actions">
            <button type="submit" class="btn-app btn-app--primary">Lọc kết quả</button>
            <a class="btn-app btn-app--ghost" asp-action="Index">Xóa lọc</a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="category-state category-state--error surface-card" role="alert">
            <span class="category-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v6M12 17h.01" />
                </svg>
            </span>
            <div>
                <p class="eyebrow">Kết nối gián đoạn</p>
                <h2>Chưa thể tải danh sách sự kiện</h2>
                <p>@Model.ErrorMessage</p>
                <a class="btn-app btn-app--primary" asp-action="Index">Thử tải lại</a>
            </div>
        </div>
    }
    else if (Model.Events.Count == 0)
    {
        <div class="category-state category-state--empty surface-card">
            <span class="category-state__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M8 3v4M16 3v4M3 10h18" />
                </svg>
            </span>
            <div>
                <p class="eyebrow">Không tìm thấy kết quả</p>
                <h2>Chưa có Event phù hợp</h2>
                <p>Thử nới rộng thời gian hoặc thay đổi bộ lọc.</p>
            </div>
        </div>
    }
    else
    {
        <div class="surface-card" style="padding: 0; overflow: hidden;">
            <div class="table-responsive">
                <table class="table align-middle style-table mb-0" style="width: 100%;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid var(--sceams-border);">
                            <th style="padding: 1rem 1.5rem;">Event</th>
                            <th>Club / Địa điểm</th>
                            <th>Thời gian</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Sức chứa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var eventItem in Model.Events)
                        {
                            <tr style="border-bottom: 1px solid var(--sceams-border);">
                                <td style="padding: 1rem 1.5rem;">
                                    <a asp-controller="Events" asp-action="Detail" asp-route-id="@eventItem.Id"><strong>@eventItem.Title</strong></a>
                                    <small style="display: block; color: var(--sceams-text-soft);">#@eventItem.Id</small>
                                </td>
                                <td>
                                    <strong>@eventItem.ClubName</strong>
                                    <small style="display: block; color: var(--sceams-text-soft);">@eventItem.VenueName</small>
                                </td>
                                <td>
                                    <span>@eventItem.StartTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    <small style="display: block; color: var(--sceams-text-soft);">đến @eventItem.EndTime.ToLocalTime().ToString("HH:mm")</small>
                                </td>
                                <td><span class="status-badge @eventItem.StatusClass">@eventItem.Status</span></td>
                                <td class="text-end">
                                    <strong>@eventItem.SlotsRemaining</strong> / @eventItem.Capacity
                                    <small style="display: block; color: var(--sceams-text-soft);">còn chỗ</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPages > 1)
            {
                <div style="padding: 1.25rem 1.5rem; border-top: 1px solid var(--sceams-border); display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
                    <small style="color: var(--sceams-text-soft);">Trang @Model.Page / @Model.TotalPages · @Model.TotalItems Event</small>
                    <div style="display: flex; gap: .5rem;">
                        @if (Model.HasPreviousPage)
                        {
                            <a class="btn-app btn-app--ghost btn-sm" asp-action="Index" asp-route-search="@Model.Search" asp-route-clubId="@Model.ClubId" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Status" asp-route-hasSlots="@Model.HasSlots" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">&larr; Trang trước</a>
                        }
                        @if (Model.HasNextPage)
                        {
                            <a class="btn-app btn-app--ghost btn-sm" asp-action="Index" asp-route-search="@Model.Search" asp-route-clubId="@Model.ClubId" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Status" asp-route-hasSlots="@Model.HasSlots" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">Trang sau &rarr;</a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>
