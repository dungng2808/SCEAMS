@{
    ViewData["Title"] = "Quyền riêng tư";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Minh bạch dữ liệu</p>
        <h1>Quyền riêng tư tại SCEAMS</h1>
        <p class="page-heading__copy">
            Cách hệ thống thu thập, sử dụng và bảo vệ thông tin trong quá trình quản lý hoạt động sinh viên.
        </p>
    </div>
</header>

<div class="privacy-layout">
    <nav class="privacy-nav" aria-label="Mục lục chính sách">
        <strong>Nội dung</strong>
        <a href="#collected-data">Dữ liệu thu thập</a>
        <a href="#data-usage">Mục đích sử dụng</a>
        <a href="#data-protection">Bảo vệ dữ liệu</a>
        <a href="#student-rights">Quyền của sinh viên</a>
        <a href="#contact">Liên hệ</a>
    </nav>

    <article class="privacy-content">
        <p class="privacy-meta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 11v5M12 8h.01" />
            </svg>
            Bản mô tả dành cho giai đoạn phát triển · Cập nhật ngày 26/07/2026
        </p>

        <section id="collected-data">
            <h2>1. Dữ liệu được thu thập</h2>
            <p>
                SCEAMS lưu các thông tin cần thiết để nhận diện tài khoản và vận hành hoạt động sinh viên, gồm họ tên, email, mã sinh viên, số điện thoại tùy chọn và lịch sử tham gia.
            </p>
        </section>

        <section id="data-usage">
            <h2>2. Mục đích sử dụng</h2>
            <p>Dữ liệu được sử dụng để:</p>
            <ul>
                <li>Xác thực tài khoản và phân quyền theo vai trò.</li>
                <li>Quản lý đăng ký câu lạc bộ, sự kiện và điểm danh.</li>
                <li>Gửi thông báo liên quan trực tiếp đến hoạt động đã đăng ký.</li>
                <li>Tạo báo cáo tổng hợp phục vụ công tác sinh viên.</li>
            </ul>
        </section>

        <section id="data-protection">
            <h2>3. Bảo vệ dữ liệu</h2>
            <p>
                Mật khẩu được lưu dưới dạng hash và không xuất hiện trong response hoặc giao diện. Quyền truy cập dữ liệu được giới hạn theo vai trò và phạm vi nghiệp vụ.
            </p>
        </section>

        <section id="student-rights">
            <h2>4. Quyền của sinh viên</h2>
            <p>
                Sinh viên có thể xem, cập nhật thông tin cá nhân phù hợp và yêu cầu hỗ trợ khi phát hiện dữ liệu không chính xác. Các thao tác nhạy cảm sẽ yêu cầu xác thực.
            </p>
        </section>

        <section id="contact">
            <h2>5. Liên hệ</h2>
            <p>
                Trong giai đoạn phát triển, mọi câu hỏi về dữ liệu có thể gửi tới bộ phận Student Affairs hoặc quản trị viên SCEAMS của trường.
            </p>
        </section>
    </article>
</div>
