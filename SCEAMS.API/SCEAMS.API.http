@SCEAMS.API_HostAddress = http://localhost:5195

GET {{SCEAMS.API_HostAddress}}/api/health
Accept: application/json

###

# Define LoginEmail and LoginPassword in your local HTTP client environment.
POST {{SCEAMS.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{LoginEmail}}",
  "password": "{{LoginPassword}}"
}

###

# Define RefreshToken from a successful login response.
POST {{SCEAMS.API_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{RefreshToken}}"
}

###

# Reusing the previous refresh token after rotation must return 401.
POST {{SCEAMS.API_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{UsedRefreshToken}}"
}

###

# Revocation is idempotent and returns 204.
POST {{SCEAMS.API_HostAddress}}/api/auth/revoke
Content-Type: application/json

{
  "refreshToken": "{{RefreshToken}}"
}

###

POST {{SCEAMS.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{LoginEmail}}",
  "password": "DefinitelyWrong1!"
}

###

# Define AccessToken from a successful login in your local HTTP client environment.
#
# Admin-only user list. Supported role values:
# Admin, Staff, Organizer and Student.
GET {{SCEAMS.API_HostAddress}}/api/users?search=student&role=Student&isActive=true&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{AdminAccessToken}}

###

# A valid token for any non-Admin role must return 403.
GET {{SCEAMS.API_HostAddress}}/api/users
Accept: application/json
Authorization: Bearer {{NonAdminAccessToken}}

###

# Define CreateUserPassword in your local HTTP client environment.
POST {{SCEAMS.API_HostAddress}}/api/users
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "fullName": "New Staff Account",
  "email": "new.staff@sceams.edu.vn",
  "studentCode": null,
  "phoneNumber": "0901234567",
  "role": "Staff",
  "isActive": true,
  "password": "{{CreateUserPassword}}",
  "confirmPassword": "{{CreateUserPassword}}"
}

###

# Reusing the email from the previous request must return 409.
POST {{SCEAMS.API_HostAddress}}/api/users
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "fullName": "Duplicate Staff Account",
  "email": "new.staff@sceams.edu.vn",
  "studentCode": null,
  "phoneNumber": null,
  "role": "Staff",
  "isActive": true,
  "password": "{{CreateUserPassword}}",
  "confirmPassword": "{{CreateUserPassword}}"
}

###

# Define AccessToken from a successful login in your local HTTP client environment.
GET {{SCEAMS.API_HostAddress}}/api/users/me
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

PUT {{SCEAMS.API_HostAddress}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "fullName": "Updated Student Name",
  "phoneNumber": "0901234567"
}

###

PUT {{SCEAMS.API_HostAddress}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "fullName": "Updated Student Name",
  "phoneNumber": "invalid-phone"
}

###

# Define CurrentPassword and NewPassword in your local HTTP client environment.
PUT {{SCEAMS.API_HostAddress}}/api/users/me/password
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "currentPassword": "{{CurrentPassword}}",
  "newPassword": "{{NewPassword}}",
  "confirmPassword": "{{NewPassword}}"
}

###

PUT {{SCEAMS.API_HostAddress}}/api/users/me/password
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "currentPassword": "DefinitelyWrong1!",
  "newPassword": "{{NewPassword}}",
  "confirmPassword": "{{NewPassword}}"
}

###

PUT {{SCEAMS.API_HostAddress}}/api/users/me/password
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "currentPassword": "{{CurrentPassword}}",
  "newPassword": "weak",
  "confirmPassword": "weak"
}

###

GET {{SCEAMS.API_HostAddress}}/api/users/me
Accept: application/json

###

GET {{SCEAMS.API_HostAddress}}/api/health/database
Accept: application/json

###

# Define RegisterPassword in your local HTTP client environment.
POST {{SCEAMS.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "fullName": "New Student",
  "email": "new.student@sceams.edu.vn",
  "studentCode": "SE999999",
  "phoneNumber": "0900000000",
  "password": "{{RegisterPassword}}",
  "confirmPassword": "{{RegisterPassword}}"
}

###
