###

# Phase 37 - GET /api/clubs (Public access: returns only Approved clubs)
GET {{SCEAMS.API_HostAddress}}/api/clubs
Accept: application/json

###

# Phase 37 - GET /api/clubs with OData filter, orderby, top and skip
GET {{SCEAMS.API_HostAddress}}/api/clubs?$filter=CategoryId eq 1&$orderby=Name asc&$top=10&$skip=0
Accept: application/json

###

# Phase 37 - GET /api/clubs for Admin (Admin can filter by any status)
GET {{SCEAMS.API_HostAddress}}/api/clubs?$filter=Status eq 'PendingApproval'
Accept: application/json
Authorization: Bearer {{AdminAccessToken}}

###

# Phase 39 - GET /api/clubs/{id} (Public access for Approved club)
GET {{SCEAMS.API_HostAddress}}/api/clubs/1
Accept: application/json

###

# Phase 39 - GET /api/clubs/{id} (Public access for non-existent or Pending club returns 404)
GET {{SCEAMS.API_HostAddress}}/api/clubs/9999
Accept: application/json

###

# Phase 41 - POST /api/clubs (Organizer proposes a new club, status automatically set to PendingApproval)
POST {{SCEAMS.API_HostAddress}}/api/clubs
Content-Type: application/json
Authorization: Bearer {{OrganizerAccessToken}}

{
  "name": "FPT Robotics & Automation Club",
  "description": "A student club dedicated to mobile robotics, automation, and IoT projects.",
  "categoryId": 1
}

###

# Phase 41 - POST /api/clubs (Student attempt returns 403 Forbidden)
POST {{SCEAMS.API_HostAddress}}/api/clubs
Content-Type: application/json
Authorization: Bearer {{StudentAccessToken}}

{
  "name": "Unauthorized Club Proposal",
  "description": "This request should be rejected with 403 Forbidden.",
  "categoryId": 1
}

###

# Phase 43 - PUT /api/clubs/{id}/approve (Admin/Staff approves a PendingApproval club)
PUT {{SCEAMS.API_HostAddress}}/api/clubs/2/approve
Accept: application/json
Authorization: Bearer {{AdminAccessToken}}

###

# Phase 43 - PUT /api/clubs/{id}/approve (Conflict when approving an already Approved club)
PUT {{SCEAMS.API_HostAddress}}/api/clubs/1/approve
Accept: application/json
Authorization: Bearer {{AdminAccessToken}}

