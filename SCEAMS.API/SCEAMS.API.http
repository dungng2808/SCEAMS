@SCEAMS.API_HostAddress = http://localhost:5195

GET {{SCEAMS.API_HostAddress}}/api/health
Accept: application/json

###

# Public and authenticated clients can read this endpoint.
GET {{SCEAMS.API_HostAddress}}/api/club-categories
Accept: application/json

###

# Define AccessToken from any successful login.
GET {{SCEAMS.API_HostAddress}}/api/club-categories
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

# Define AdminAccessToken and CreateClubCategoryName in your local
# HTTP client environment.
POST {{SCEAMS.API_HostAddress}}/api/club-categories
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "name": "{{CreateClubCategoryName}}",
  "description": "Category created during Phase 31 verification."
}

###

# Define CreateClubCategoryDuplicateName as the previous name with different
# casing. The request must return 409.
POST {{SCEAMS.API_HostAddress}}/api/club-categories
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "name": "{{CreateClubCategoryDuplicateName}}",
  "description": "Duplicate category"
}

###

# A valid non-Admin token must return 403.
POST {{SCEAMS.API_HostAddress}}/api/club-categories
Content-Type: application/json
Authorization: Bearer {{NonAdminAccessToken}}

{
  "name": "Unauthorized Category",
  "description": null
}

###

# A blank category name must return 400.
POST {{SCEAMS.API_HostAddress}}/api/club-categories
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "name": "   ",
  "description": null
}

###

# Define UpdateClubCategoryId and UpdateClubCategoryName in your local
# HTTP client environment.
PUT {{SCEAMS.API_HostAddress}}/api/club-categories/{{UpdateClubCategoryId}}
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "name": "{{UpdateClubCategoryName}}",
  "description": "Category updated during Phase 33 verification."
}

###

# Define ExistingClubCategoryName as another category's name.
# The request must return 409 without changing the target category.
PUT {{SCEAMS.API_HostAddress}}/api/club-categories/{{UpdateClubCategoryId}}
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "name": "{{ExistingClubCategoryName}}",
  "description": "Duplicate category name"
}

###

# An unknown category ID must return 404.
PUT {{SCEAMS.API_HostAddress}}/api/club-categories/2147483647
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "name": "Missing Category",
  "description": null
}

###

# A valid non-Admin token must return 403.
PUT {{SCEAMS.API_HostAddress}}/api/club-categories/{{UpdateClubCategoryId}}
Content-Type: application/json
Authorization: Bearer {{NonAdminAccessToken}}

{
  "name": "Forbidden Category Update",
  "description": null
}

###

# Define DeleteClubCategoryId in your local HTTP client environment.
# Successful deletion of an unused category returns 204.
DELETE {{SCEAMS.API_HostAddress}}/api/club-categories/{{DeleteClubCategoryId}}
Authorization: Bearer {{AdminAccessToken}}

###

# Attempting to delete a category associated with one or more clubs must return 409 Conflict.
# Define UsedClubCategoryId in your local HTTP client environment.
DELETE {{SCEAMS.API_HostAddress}}/api/club-categories/{{UsedClubCategoryId}}
Authorization: Bearer {{AdminAccessToken}}

###

# An unknown category ID must return 404.
DELETE {{SCEAMS.API_HostAddress}}/api/club-categories/2147483647
Authorization: Bearer {{AdminAccessToken}}

###

# A valid non-Admin token must return 403.
DELETE {{SCEAMS.API_HostAddress}}/api/club-categories/{{DeleteClubCategoryId}}
Authorization: Bearer {{NonAdminAccessToken}}

###

# Define LoginEmail and LoginPassword in your local HTTP client environment.
POST {{SCEAMS.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{LoginEmail}}",
  "password": "{{LoginPassword}}"
}

###

# Define RefreshToken from a successful login response.
POST {{SCEAMS.API_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{RefreshToken}}"
}

###

# Reusing the previous refresh token after rotation must return 401.
POST {{SCEAMS.API_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{UsedRefreshToken}}"
}

###

# Revocation is idempotent and returns 204.
POST {{SCEAMS.API_HostAddress}}/api/auth/revoke
Content-Type: application/json

{
  "refreshToken": "{{RefreshToken}}"
}

###

POST {{SCEAMS.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{LoginEmail}}",
  "password": "DefinitelyWrong1!"
}

###

# Define AccessToken from a successful login in your local HTTP client environment.
#
# Admin-only user list. Supported role values:
# Admin, Staff, Organizer and Student.
GET {{SCEAMS.API_HostAddress}}/api/users?search=student&role=Student&isActive=true&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{AdminAccessToken}}

###

# A valid token for any non-Admin role must return 403.
GET {{SCEAMS.API_HostAddress}}/api/users
Accept: application/json
Authorization: Bearer {{NonAdminAccessToken}}

###

# Define CreateUserPassword in your local HTTP client environment.
POST {{SCEAMS.API_HostAddress}}/api/users
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "fullName": "New Staff Account",
  "email": "new.staff@sceams.edu.vn",
  "studentCode": null,
  "phoneNumber": "0901234567",
  "role": "Staff",
  "isActive": true,
  "password": "{{CreateUserPassword}}",
  "confirmPassword": "{{CreateUserPassword}}"
}

###

# Reusing the email from the previous request must return 409.
POST {{SCEAMS.API_HostAddress}}/api/users
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "fullName": "Duplicate Staff Account",
  "email": "new.staff@sceams.edu.vn",
  "studentCode": null,
  "phoneNumber": null,
  "role": "Staff",
  "isActive": true,
  "password": "{{CreateUserPassword}}",
  "confirmPassword": "{{CreateUserPassword}}"
}

###

# Define UpdateUserId from an existing account.
# Role and active status are intentionally absent from this DTO.
PUT {{SCEAMS.API_HostAddress}}/api/users/{{UpdateUserId}}
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "fullName": "Updated Staff Account",
  "email": "updated.staff@sceams.edu.vn",
  "studentCode": null,
  "phoneNumber": "0912345678"
}

###

# An unknown user ID must return 404.
PUT {{SCEAMS.API_HostAddress}}/api/users/2147483647
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "fullName": "Missing Account",
  "email": "missing.user@sceams.edu.vn",
  "studentCode": null,
  "phoneNumber": null
}

###

# Invalid profile data must return 400 with field errors.
PUT {{SCEAMS.API_HostAddress}}/api/users/{{UpdateUserId}}
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "fullName": " ",
  "email": "invalid-email",
  "studentCode": null,
  "phoneNumber": "invalid-phone"
}

###

# Lock an account. Save its refresh token before running this request
# if you want to verify the refresh rejection below.
PUT {{SCEAMS.API_HostAddress}}/api/users/{{UpdateUserId}}/active-status
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "isActive": false
}

###

# A locked account must receive 403 even with the correct password.
POST {{SCEAMS.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{LockedUserEmail}}",
  "password": "{{LockedUserPassword}}"
}

###

# A refresh token issued before locking must receive 401.
POST {{SCEAMS.API_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{LockedUserRefreshToken}}"
}

###

# Admin cannot lock the account represented by AdminAccessToken.
PUT {{SCEAMS.API_HostAddress}}/api/users/{{AdminUserId}}/active-status
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "isActive": false
}

###

# Unlock the test account.
PUT {{SCEAMS.API_HostAddress}}/api/users/{{UpdateUserId}}/active-status
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "isActive": true
}

###

# Assign one of the four supported roles:
# Admin, Staff, Organizer or Student.
PUT {{SCEAMS.API_HostAddress}}/api/users/{{UpdateUserId}}/role
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "role": "Organizer"
}

###

# An unknown role must return 400.
PUT {{SCEAMS.API_HostAddress}}/api/users/{{UpdateUserId}}/role
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "role": "SuperAdmin"
}

###

# An unknown user ID must return 404.
PUT {{SCEAMS.API_HostAddress}}/api/users/2147483647/role
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "role": "Staff"
}

###

# The last active Admin cannot demote their own account.
PUT {{SCEAMS.API_HostAddress}}/api/users/{{AdminUserId}}/role
Content-Type: application/json
Authorization: Bearer {{AdminAccessToken}}

{
  "role": "Staff"
}

###

# A refresh token issued before a role change must return 401.
POST {{SCEAMS.API_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{RoleChangeRefreshToken}}"
}

